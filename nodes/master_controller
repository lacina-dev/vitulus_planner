    # =====================================================================
    # persistent state
    # =====================================================================
    def _default_state(self):
        return {
            "automation_enabled": False,
            "calendar": [],
            "last_run_by_event": {},      # event id -> date really started
            "closed_slot_by_event": {},   # event id -> date given up
            "scan_from": None,            # slots before this are resolved
            "run": None,
            "issues": [],
            "interrupted_event_id": None,
            "interrupted_reason": None,
            "inhibit": self.default_inhibit,
        }

    def _load_state(self):
        for path in (self.state_file, self.state_file + '.prev'):
            if not os.path.exists(path):
                continue
            try:
                with open(path, 'r') as f:
                    data = json.load(f)
                if not isinstance(data, dict):
                    raise ValueError("not an object")
                defaults = self._default_state()
                for k, v in defaults.items():
                    data.setdefault(k, v)
                rospy.loginfo("Loaded state from %s", path)
                return data
            except Exception as e:
                rospy.logerr("Failed to load state %s: %s", path, str(e))
        # Nothing readable: the default is OFF, so a broken file cannot start
        # anything. (The broken file stays until the next good save.)
        return self._default_state()

    def _save_state(self):
        """Atomic and durable: power can be cut at any moment, a half written
        state file must never replace the good one."""
        tmp = self.state_file + '.tmp'
        try:
            with open(tmp, 'w') as f:
                json.dump(self.persistent, f, indent=2)
                f.flush()
                os.fsync(f.fileno())
            if os.path.exists(self.state_file):
                try:
                    os.replace(self.state_file, self.state_file + '.prev')
                except OSError:
                    pass
            os.replace(tmp, self.state_file)
            fd = os.open(self.state_dir, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        except Exception as e:
            rospy.logerr("Failed to save state: %s", str(e))

    def _load_window(self):
        """The owner's window from the state file; none or a broken one leaves
        the yaml defaults."""
        stored = self.persistent.get('allowed_window')
        if stored is None:
            return
        try:
            (self.window_enabled, self.window_start,
             self.window_end) = MowerScheduler.clean_window(
                stored, (self.window_enabled, self.window_start, self.window_end))
        except ValueError:
            rospy.logerr("Stored window %s is not valid, using the defaults.",
                         str(stored))

    def _set_interrupted(self, event_id, reason):
        with self.lock:
            self.persistent['interrupted_event_id'] = event_id
            self.persistent['interrupted_reason'] = reason
            self._save_state()

    def _clear_interrupted(self):
        with self.lock:
            self.persistent['interrupted_event_id'] = None
            self.persistent['interrupted_reason'] = None
            self.persistent['run'] = None
            self._save_state()

    def _run(self):
        """The persisted run, also for a state file from before runs existed."""
        with self.lock:
            run = self.persistent.get('run')
            eid = self.persistent.get('interrupted_event_id')
            if run is None and eid is not None:
                ev = self._find_event(eid)
                run = self._new_run(ev or {'id': eid, 'program_name': ''}, None)
                run['started'] = True
                self.persistent['run'] = run
            return run

    def _new_run(self, ev, slot_dt):
        return {
            'event_id': ev['id'],
            'program': ev.get('program_name', ''),
            'site': ev.get('site') or None,   # map of the slot, None = old event
            'slot': slot_dt.strftime("%Y-%m-%dT%H:%M") if slot_dt else None,
            'created': self._t(),
            'started': False,     # the mission really got past its start checks
            'following': False,   # a mission of this run is out now
            'reason': None,       # why it waits
            'wait_until': 0.0,
            'resumes': 0,
            'no_progress': 0,
            'critical': 0,
            'rejects': 0,
            'checkpoint': None,
        }

    def _update_run(self, **fields):
        with self.lock:
            run = self.persistent.get('run')
            if run is None:
                return
            run.update(fields)
            self._save_state()

    def _issue(self, code, program='', **detail):
        """Something the owner should see. Kept (last 20), shown until cleared."""
        self.log("[Master] %s %s %s" % (code, program, detail or ''))
        with self.lock:
            self.persistent['issues'] = (self.persistent.get('issues') or [])[-19:] + [{
                't': self._now().strftime("%Y-%m-%dT%H:%M"),
                'code': code, 'program': program, 'detail': detail}]
            self._save_state()

