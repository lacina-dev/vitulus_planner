# ---------------------------------------------------------------------------
# Calendar evaluator
# ---------------------------------------------------------------------------
class MowerScheduler(object):
    """Pure-Python calendar evaluator.

    Operates on a list of CalendarEvent dictionaries::

        {
          "id":            "uuid-or-unique-string",
          "program_name":  "Predni_Zahrada",
          "enabled":       true,
          "recurrence":    "none|daily|weekly|monthly|yearly",
          "start_time":    "HH:MM",
          "start_date":    "YYYY-MM-DD",
          "days_of_week":  [0..6],        # weekly only (0=Mon, 6=Sun)
          "day_of_month":  1..31,         # monthly only
          "month":         1..12          # yearly only
        }
    """

    # After start_time, how long the event remains "active now"
    START_WINDOW_SECONDS = 900  # 15 min

    @staticmethod
    def _parse_hhmm(s):
        try:
            parts = s.split(':')
            h, m = int(parts[0]), int(parts[1])
            if 0 <= h <= 23 and 0 <= m <= 59:
                return h, m
        except Exception:
            pass
        return None

    @staticmethod
    def _parse_date(s):
        try:
            return datetime.datetime.strptime(s, "%Y-%m-%d").date()
        except Exception:
            return None

    @classmethod
    def validate_event(cls, ev):
        if not isinstance(ev, dict):
            return False
        if not ev.get('id') or not ev.get('program_name'):
            return False
        if cls._parse_hhmm(ev.get('start_time', '')) is None:
            return False
        rec = ev.get('recurrence', 'none')
        if rec not in ('none', 'daily', 'weekly', 'monthly', 'yearly'):
            return False
        if rec == 'none' and cls._parse_date(ev.get('start_date', '')) is None:
            return False
        if rec == 'weekly':
            dows = ev.get('days_of_week', [])
            if not isinstance(dows, list) or not all(
                    isinstance(d, int) and 0 <= d <= 6 for d in dows):
                return False
        if rec == 'monthly':
            dom = ev.get('day_of_month')
            if not (isinstance(dom, int) and 1 <= dom <= 31):
                return False
        if rec == 'yearly':
            if not (isinstance(ev.get('day_of_month'), int)
                    and 1 <= ev['day_of_month'] <= 31):
                return False
            if not (isinstance(ev.get('month'), int)
                    and 1 <= ev['month'] <= 12):
                return False
        return True

    @classmethod
    def validate_calendar(cls, events):
        if not isinstance(events, list):
            return []
        return [e for e in events if cls.validate_event(e)]

    @classmethod
    def _event_runs_on(cls, ev, day):
        """Return True if event recurrence permits a run on the given date."""
        if not ev.get('enabled', False):
            return False
        sd_str = ev.get('start_date')
        if sd_str:
            sd = cls._parse_date(sd_str)
            if sd is not None and day < sd:
                return False
        rec = ev.get('recurrence', 'none')
        if rec == 'none':
            sd = cls._parse_date(ev.get('start_date', ''))
            return sd is not None and sd == day
        if rec == 'daily':
            return True
        if rec == 'weekly':
            return day.weekday() in ev.get('days_of_week', [])
        if rec == 'monthly':
            return day.day == ev.get('day_of_month')
        if rec == 'yearly':
            return (day.day == ev.get('day_of_month')
                    and day.month == ev.get('month'))
        return False

    @classmethod
    def get_active_event(cls, calendar_events, last_run_by_event, now=None):
        """Return event whose start window contains now and hasn't run today."""
        if now is None:
            now = datetime.datetime.now()
        today_str = now.strftime("%Y-%m-%d")

        for ev in calendar_events:
            if not cls._event_runs_on(ev, now.date()):
                continue
            hm = cls._parse_hhmm(ev.get('start_time', ''))
            if hm is None:
                continue
            start_dt = now.replace(hour=hm[0], minute=hm[1],
                                   second=0, microsecond=0)
            diff = (now - start_dt).total_seconds()
            # Window: 0 to +15 min after start_time
            if 0 <= diff <= cls.START_WINDOW_SECONDS:
                if last_run_by_event.get(ev['id']) != today_str:
                    return ev
        return None

    @classmethod
    def get_next_event(cls, calendar_events, now=None, horizon_days=400):
        """Find closest upcoming event.

        Returns (next_datetime, event_dict) or (None, None).
        """
        if now is None:
            now = datetime.datetime.now()
        best_dt = None
        best_ev = None
        for d_idx in range(horizon_days):
            day = (now + datetime.timedelta(days=d_idx)).date()
            for ev in calendar_events:
                if not cls._event_runs_on(ev, day):
                    continue
                hm = cls._parse_hhmm(ev.get('start_time', ''))
                if hm is None:
                    continue
                cand = datetime.datetime.combine(
                    day, datetime.time(hour=hm[0], minute=hm[1]))
                if cand <= now:
                    continue
                if best_dt is None or cand < best_dt:
                    best_dt = cand
                    best_ev = ev
        return best_dt, best_ev

    @classmethod
    def slots_between(cls, calendar_events, after, until):
        """Every (slot_datetime, event) with after < slot <= until, oldest
        first. Slots are wall-clock times of a date, so a DST change does not
        move them; a date is walked only once whatever the clock did."""
        out = []
        day = after.date()
        while day <= until.date():
            for ev in calendar_events:
                if not cls._event_runs_on(ev, day):
                    continue
                hm = cls._parse_hhmm(ev.get('start_time', ''))
                if hm is None:
                    continue
                cand = datetime.datetime.combine(
                    day, datetime.time(hour=hm[0], minute=hm[1]))
                if after < cand <= until:
                    out.append((cand, ev))
            day += datetime.timedelta(days=1)
        out.sort(key=lambda x: x[0])
        return out

    @staticmethod
    def real_seconds(a, b):
        """Real seconds from local time a to local time b. Plain b - a is an
        hour off across a DST change (27. 3. 2027: the wake-up came an hour
        late and the slot was gone)."""
        return time.mktime(b.timetuple()) - time.mktime(a.timetuple())

    # --- allowed time-window ("don't mow at night") --------------------------
    @staticmethod
    def within_window(now, start_hm, end_hm):
        """True if now's time is within [start_hm, end_hm].

        Supports same-day windows (start <= end, e.g. 07:00-21:00) and
        wrap-around windows (start > end, e.g. 21:00-07:00).
        """
        if start_hm is None or end_hm is None:
            return True
        t = now.time()
        start = datetime.time(hour=start_hm[0], minute=start_hm[1])
        end = datetime.time(hour=end_hm[0], minute=end_hm[1])
        if start <= end:
            return start <= t <= end
        # wrap-around midnight
        return t >= start or t <= end

    @staticmethod
    def next_window_start(now, start_hm):
        """Next datetime at which the allowed window opens (>= now)."""
        if start_hm is None:
            return now
        cand = now.replace(hour=start_hm[0], minute=start_hm[1],
                           second=0, microsecond=0)
        if cand <= now:
            cand += datetime.timedelta(days=1)
        return cand

    @staticmethod
    def window_end_after(now, end_hm):
        """Next datetime at which the allowed window closes (> now)."""
        cand = now.replace(hour=end_hm[0], minute=end_hm[1],
                           second=0, microsecond=0)
        if cand <= now:
            cand += datetime.timedelta(days=1)
        return cand

    @classmethod
    def clean_window(cls, cfg, current):
        """A window setting from /scheduler/set_window or the state file.

        cfg: {"enabled": bool, "start": "HH:MM", "end": "HH:MM"}, a missing key
        keeps its value from current (enabled, start_hm, end_hm). Returns the
        new (enabled, start_hm, end_hm); ValueError('invalid' or 'equal').
        start == end is refused: it would read as "all day" to one person and
        "never" to another, and within_window takes it for one minute.
        """
        if not isinstance(cfg, dict):
            raise ValueError('invalid')
        enabled = cfg.get('enabled', current[0])
        if not isinstance(enabled, bool):
            raise ValueError('invalid')
        start = cls._parse_hhmm(cfg['start']) if 'start' in cfg else current[1]
        end = cls._parse_hhmm(cfg['end']) if 'end' in cfg else current[2]
        if start is None or end is None:
            raise ValueError('invalid')
        if start == end:
            raise ValueError('equal')
        return enabled, start, end


# ---------------------------------------------------------------------------
# Master Controller
# ---------------------------------------------------------------------------
class MasterController(object):
    STATE_DISABLED = "DISABLED"
    STATE_INIT = "INIT"
    STATE_INHIBITED = "INHIBITED"
    STATE_IDLE = "IDLE"
    STATE_MOWING = "MOWING"
    STATE_WAIT_OFF_DOCK = "WAIT_OFF_DOCK"
    STATE_PREPARE_SLEEP = "PREPARE_SLEEP"
    # A map load says 'switching' once; the planner bounds it (180 s) and says
    # how it ended. Longer silence = the planner is gone (vitulus-field#46).
    MAP_GATE_MAX_S = 200.0

    def __init__(self):
        rospy.init_node('master_controller')

        # ---- parameters ----------------------------------------------------
        self.startup_delay_s = rospy.get_param('~startup_delay_s', 10.0)
        self.boot_grace_period_s = rospy.get_param(
            '~boot_grace_period_s', 300.0)
        self.check_interval_s = rospy.get_param('~check_interval_s', 30.0)
        self.wake_before_program_s = rospy.get_param(
            '~wake_before_program_s', 600.0)        # 10 min
        self.boot_time_buffer_s = rospy.get_param(
            '~boot_time_buffer_s', 120.0)
        self.idle_sleep_threshold_s = rospy.get_param(
            '~idle_sleep_threshold_s', 1200.0)     # 20 min
        self.off_dock_wait_s = rospy.get_param(
            '~off_dock_wait_s', 1200.0)            # 20 min

        # Battery: below battery_recovery_min_capacity the mission refuses to
        # start (same value as its battery_min_start_pct). After a low-battery
        # return the program resumes only at battery_resume_after_low_pct, so
        # it does not come back after a few minutes of mowing.
        self.battery_resume_min = rospy.get_param(
            '~battery_recovery_min_capacity', 40)
        self.battery_resume_low = rospy.get_param(
            '~battery_resume_after_low_pct', 80)

        # Slots and runs (see the module docstring).
        self.catchup_max_s = rospy.get_param('~catchup_max_h', 4.0) * 3600.0
        self.start_min_left_s = rospy.get_param(
            '~start_min_window_left_min', 30.0) * 60.0
        self.run_max_age_s = rospy.get_param('~run_max_age_h', 48.0) * 3600.0
        self.reject_retry_s = rospy.get_param('~reject_retry_min', 5.0) * 60.0
        self.reject_max = rospy.get_param('~reject_retry_max', 6)
        self.critical_max = rospy.get_param('~critical_retry_max', 3)
        self.gps_retry_s = rospy.get_param('~gps_retry_min', 5.0) * 60.0
        self.resume_max = rospy.get_param('~resume_max_attempts', 12)
        self.no_progress_max = rospy.get_param('~resume_no_progress_max', 3)
        self.window_overrun_s = rospy.get_param(
            '~window_overrun_max_min', 30.0) * 60.0
        self.mission_lost_grace_s = rospy.get_param(
            '~mission_lost_grace_s', 20.0)
        self.agent_status_max_age_s = rospy.get_param(
            '~agent_status_max_age_s', 15.0)
        self.tick_hz = rospy.get_param('~tick_hz', 1.0)

        # Recovery sleep durations.
        self.weather_sleep_duration_s = rospy.get_param(
            '~weather_sleep_duration_h', 4.0) * 3600.0
        self.temp_sleep_duration_s = rospy.get_param(
            '~temp_sleep_duration_h', 1.0) * 3600.0
        self.temp_spike_wait_s = rospy.get_param(
            '~temp_spike_wait_min', 5.0) * 60.0
        self.critical_sleep_duration_s = rospy.get_param(
            '~critical_error_sleep_duration_h', 0.5) * 3600.0
        self.terminal_short_wait_s = rospy.get_param(
            '~terminal_error_short_wait_min', 20.0) * 60.0
        self.terminal_long_sleep_s = rospy.get_param(
            '~terminal_error_long_sleep_h', 8.0) * 3600.0

        # Allowed time-window ("don't mow at night"). These are the defaults; a
        # setting in the state file replaces them below.
        self.window_enabled = rospy.get_param('~allowed_window_enabled', True)
        self.window_start = MowerScheduler._parse_hhmm(
            str(rospy.get_param('~allowed_window_start', '07:00')))
        self.window_end = MowerScheduler._parse_hhmm(
            str(rospy.get_param('~allowed_window_end', '21:00')))
        self.default_inhibit = rospy.get_param('~default_inhibit', False)

        # Lead time used when computing timed wake-ups.
        self.wake_lead_s = self.wake_before_program_s + self.boot_time_buffer_s

        # Sleep sequence (node_planner/sleep_manager.py).
        self.sleep_cfg = sleep_manager.SleepConfig(
            wait_before_standby_s=rospy.get_param(
                '~sleep_wait_before_standby_s', 180.0),
            min_off_s=rospy.get_param('~sleep_min_off_s', 120.0),
            min_sleep_s=rospy.get_param('~sleep_min_s', 900.0),
            max_segment_s=rospy.get_param('~sleep_max_segment_h', 12.0) * 3600.0,
            timer_drift=rospy.get_param('~sleep_timer_drift', 0.005),
            final_grace_s=rospy.get_param('~sleep_final_grace_s', 20.0),
            retry_s=rospy.get_param('~sleep_retry_s', 3.0),
            cut_margin_s=rospy.get_param('~sleep_cut_margin_s', 60.0),
            fail_cooldown_s=rospy.get_param('~sleep_fail_cooldown_s', 1800.0),
            charged_offset_s=rospy.get_param('~sleep_charged_offset_s', 300.0),
            charge_full_h=rospy.get_param('~charge_full_h', 6.0),
            charge_min_h=rospy.get_param('~charge_sleep_min_h', 0.5),
            charge_max_h=rospy.get_param('~charge_sleep_max_h', 6.0))
        # 'timed' is the only charge sleep that surely ends with the current
        # firmware; 'until_charged' needs the patched one (docs in the yaml).
        self.charge_sleep_mode = rospy.get_param(
            '~charge_sleep_mode', sleep_manager.MODE_TIMED)
        self.charge_sleep_max_no_gain = rospy.get_param(
            '~charge_sleep_max_no_gain', 2)
        self.sleep_check_logins = rospy.get_param('~sleep_check_logins', True)
        self.sleep_check_ui = rospy.get_param('~sleep_check_ui', True)
        self.boot_id_file = rospy.get_param(
            '~boot_id_file', '/proc/sys/kernel/random/boot_id')
        sleep_cmd = rospy.get_param('~sleep_shutdown_cmd', os.path.join(
            os.path.dirname(os.path.realpath(__file__)), 'sleep_shutdown'))

        # ---- persistence ---------------------------------------------------
        self.state_dir = os.path.expanduser('~/.vitulus')
        if not os.path.exists(self.state_dir):
            os.makedirs(self.state_dir)
        self.state_file = os.path.join(self.state_dir, 'scheduler_state.json')

        # ---- threading -----------------------------------------------------
        self.lock = threading.Lock()

        # ---- runtime state -------------------------------------------------
        self.is_in_dock = False
        self.program_list = []
        # vitulus-field#46: the planner's list holds the programs of the map
        # that is on; a slot may belong to another map. {site: [{name, ...}]}
        self.site_programs = None
        self.start_state = None     # last /web_plan/program_start_state
        self.start_state_t = 0.0
        self.programs_loaded = False
        self.battery_capacity = 0
        self.supply_status = "UNKNOWN"
        self.charger_status = "UNKNOWN"
        # "" = not heard from mower_smach yet: nothing starts until it speaks.
        self.smach_status = ""
        self.mission_busy = None
        self.mission_started_name = ""
        self.dock_status = None
        self.mux_active = ""
        self.agent_status = None
        self.agent_status_t = 0.0
        self.agent_mission_active = False
        self.weather = None
        self.stop_reason = ""
        self.active_program_name = ""
        self.pm_status = None
        self.pm_status_time = 0.0
        self.dock_program = None
        self.ui_clients = 0

        # sleep
        self.sleep_seq = sleep_manager.SleepSequencer(
            self.sleep_cfg, self, self._pm_status,
            sleep_manager.ShutdownHelper(sleep_cmd), log=self.log,
            clock=self._t)
        self.sleep_block = None
        self.last_wake = None
        self._sleep_cooldown_until = 0.0
        self._sleep_cooldown_reason = None
        self._sleep_start_checked = False
        self._sleep_last_refusal = None
        self._home_sent = False
        self._logins_cache = (0.0, [])

        # FSM
        self.state = self.STATE_INIT
        self.node_start_time = self._t()
        self.off_dock_since = None
        self.terminal_error_since = None
        self._mowing_grace_until = 0.0
        # A program start is confirmed only when the SMACH picks it up; until
        # then the (latched) stop_reason of the previous mission is not ours.
        self._mission_seen = True
        self._mission_start_deadline = 0.0
        self._last_idle_eval = 0.0
        self._pending_recovery_reason = None
        self._ready_no_reason_since = None
        self._window_end_sent = 0.0
        self._window_end_first = 0.0
        self._window_moved = False    # changed while mowing: _check_window_end
        self._window_error = None     # the last refused /scheduler/set_window
        self._sleep_replan = False    # changed during a sleep sequence
        self._attached = False
        self._code = 'init'
        self._code_detail = {}
        self._status_text = ""
        self._pending_view = []
        self._report_last = None
        self._report_t = 0.0

        # ---- persistent state ----------------------------------------------
        self.persistent = self._load_state()
        self.automation_on = bool(self.persistent.get('automation_enabled'))
        self.is_inhibited = bool(
            self.persistent.get('inhibit', self.default_inhibit))
        self.calendar = MowerScheduler.validate_calendar(
            self.persistent.get('calendar', []))
        self.persistent['calendar'] = self.calendar
        self._load_window()
        self._save_state()

        # ---- publishers ----------------------------------------------------
        self.status_pub = rospy.Publisher(
            '/scheduler/status', String, latch=True, queue_size=1)
        self.next_run_pub = rospy.Publisher(
            '/scheduler/next_run', String, latch=True, queue_size=1)
        self.inhibit_status_pub = rospy.Publisher(
            '/scheduler/inhibit_status', Bool, latch=True, queue_size=1)
        self.calendar_pub = rospy.Publisher(
            '/scheduler/calendar', String, latch=True, queue_size=1)
        self.enabled_pub = rospy.Publisher(
            '/scheduler/enabled', Bool, latch=True, queue_size=1)
        self.report_pub = rospy.Publisher(
            '/scheduler/report', String, latch=True, queue_size=1)
        # True while a calendar run is out: mower_smach then keeps the rain
        # checks on even with weather_rain_bypass (a manual-run override).
        self.run_active_pub = rospy.Publisher(
            '/scheduler/run_active', Bool, latch=True, queue_size=1)
        self.finish_after_path_pub = rospy.Publisher(
            '/mower_smach/finish_after_path', Bool, queue_size=1)
        self.return_home_pub = rospy.Publisher(
            '/mower_smach/return_home', String, queue_size=1)

        self.program_select_pub = rospy.Publisher(
            '/web_plan/program_select', String, queue_size=1)
        self.program_select_resume_pub = rospy.Publisher(
            '/web_plan/program_select_resume', String, queue_size=1)
        self.smach_reset_pub = rospy.Publisher(
            '/mower_smach/reset', Bool, queue_size=1)

        # power module (vitulus_ups) - topics live under the /pm/ namespace,
        # matching the webui power-module controls. The PM performs the actual
        # power-off and sets the wake timer.
        self.set_sleep_time_pub = rospy.Publisher(
            '/pm/set_sleep_time', UInt64, queue_size=1)
        self.set_robot_sleep_pub = rospy.Publisher(
            '/pm/set_robot_sleep', Bool, queue_size=1)
        self.set_sleep_until_charged_pub = rospy.Publisher(
            '/pm/set_sleep_until_charged', Bool, queue_size=1)
        self.set_sleep_wait_before_standby_pub = rospy.Publisher(
            '/pm/set_sleep_wait_before_standby', UInt64, queue_size=1)
        self.set_sleep_wait_charged_offset_pub = rospy.Publisher(
            '/pm/set_sleep_wait_charged_offset', UInt64, queue_size=1)
        self.start_docking_pub = rospy.Publisher(
            '/dock_smach/start_docking', DockProgram, queue_size=1)

        # logging
        self.lcd_log_pub = rospy.Publisher(
