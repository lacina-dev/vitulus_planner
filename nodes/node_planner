    def draw_multilines(self, multilines, np_coverage):
        # Draw multilines to map
        for line in multilines.geoms:
            points = [[self.map_data.x_origin + int(x / self.map_data.resolution),
                       self.map_data.y_origin + int(y / self.map_data.resolution)] for x, y in zip(*line.coords.xy)]
            np_coverage = cv2.polylines(np_coverage, pts=np.array([points]).astype(np.int32),
                                        isClosed=True, color=180, thickness=1)
        return np_coverage

    def save_programs(self):
        """Persist the program list. The pickle and its .BACK copy are NEVER
        overwritten in the same step: .BACK receives the PREVIOUS (known good)
        generation, then the pickle is replaced atomically."""
        try:
            if self._programs_pkl_good and exists(_PROGRAMS_PKL):
                shutil.copyfile(_PROGRAMS_PKL, _PROGRAMS_PKL + '.BACK.tmp')
                os.replace(_PROGRAMS_PKL + '.BACK.tmp', _PROGRAMS_PKL + '.BACK')
            planner_io.save_pickle_checked(_PROGRAMS_PKL, self.permanent_program_list_msg)
            self._programs_pkl_good = True
            rospy.loginfo("[{}] Planner programs saved.".format(rospy.get_caller_id()))
            return True
        except Exception as e:
            rospy.logerr("[{}] Planner programs save failed: {}".format(
                rospy.get_caller_id(), e))
            return False

    def load_programs(self):
        """Load the program pickle, falling back to its .BACK generation. When
        neither loads, the list in memory is not authoritative: flag it so the
        served site's programs.yaml gets imported (and nothing is exported)."""
        backup = _PROGRAMS_PKL + '.BACK'
        if not exists(_PROGRAMS_PKL) and not exists(backup):
            # Fresh install / no program created yet — not an error.
            rospy.loginfo("[{}] No saved programs yet ({} does not exist).".format(
                rospy.get_caller_id(), _PROGRAMS_PKL))
            self._programs_need_import = True
            return False
        for path in (_PROGRAMS_PKL, backup):
            if exists(path) and self._load_programs_from(path):
                # The .BACK generation may be older than the site's programs.yaml:
                # reconcile with the yaml (non-destructively) on the next load.
                self._programs_need_import = (path != _PROGRAMS_PKL)
                return True
        self._programs_need_import = True
        rospy.logerr("[{}] Program pickle unreadable — the list will be imported "
                     "from the served site's programs.yaml.".format(rospy.get_caller_id()))
        return False

    def _load_programs_from(self, pkl_path):
        try:
            from vitulus_msgs.msg import PlannerProgram as _PlannerProgram

            # Known old slot layout (18 fields, before schedule-fields removal).
            # Empirically determined from existing pickle data.
            OLD_SLOTS_18 = [
                'header', 'name', 'map_name', 'last_result', 'area', 'length',
                'last_duration_minutes', 'start_hour', 'mon', 'tue', 'wed', 'thu',
                'fri', 'sat', 'sun', 'start_minute', 'zone_list', 'enabled',
            ]

            raw_states = []

            def _capture_setstate(self, state):
                raw_states.append(list(state))
                # Do not call original; we reconstruct correctly below.

            _PlannerProgram.__setstate__ = _capture_setstate
            try:
                with open(pkl_path, 'rb') as f:
                    old_msg = pickle.load(f)
            finally:
                del _PlannerProgram.__setstate__

            if not hasattr(old_msg, 'program_list'):
                # A pickled None / foreign object: treat as "no saved programs".
                rospy.logwarn("[{}] {} holds no program list ({}).".format(
                    rospy.get_caller_id(), pkl_path, type(old_msg).__name__))
                return False

            current_slots = list(_PlannerProgram.__slots__)

            new_programs = []
            for state in raw_states:
                prg = _PlannerProgram()
                if len(state) == len(OLD_SLOTS_18):
                    # Old format: map values by field name
                    old_dict = dict(zip(OLD_SLOTS_18, state))
                    for slot in current_slots:
                        if slot in old_dict:
                            setattr(prg, slot, old_dict[slot])
                else:
                    # Current or compatible format: assign by position
                    for slot, val in zip(current_slots, state):
                        setattr(prg, slot, val)

                # Validate / apply defaults for new fields
                if not isinstance(getattr(prg, 'rpm', None), int) or isinstance(prg.rpm, bool):
                    prg.rpm = 0
                if not isinstance(getattr(prg, 'cut_height', None), int) or isinstance(prg.cut_height, bool):
                    prg.cut_height = 0
                if getattr(prg, 'speed', None) not in ('slow', 'mid', 'fast'):
                    prg.speed = 'mid'
                if not isinstance(getattr(prg, 'override_zone', None), bool):
                    prg.override_zone = False
                if not isinstance(getattr(prg, 'zone_list', None), list):
                    prg.zone_list = []

                new_programs.append(prg)

            self.permanent_program_list_msg.header = old_msg.header
            self.permanent_program_list_msg.program_list = new_programs

            # Re-save in the current format so future restarts load cleanly
            # (.BACK is rotated only when the primary pickle itself was good).
            self._programs_pkl_good = (pkl_path == _PROGRAMS_PKL)
            self.save_programs()

            self.program_list_publisher()
            self.log_publisher("Planner programs loaded")
            rospy.loginfo("[{}] Planner programs loaded.".format(rospy.get_caller_id()))
            return True
        except Exception as e:
            rospy.logerr("[{}] Failed to load programs from {}: {}".format(
                rospy.get_caller_id(), pkl_path, e))
            return False

    def save_running_data(self):
        # Never persist a None workspace: pickle.dump(None) writes a valid 4-byte
        # file that later gets copied to saves/<site>.pkl and "loads" as nothing.
        if self.map_data is None:
            rospy.loginfo("[{}] Planner data NOT saved: no workspace (map_data is "
                          "None).".format(rospy.get_caller_id()))
            return False
        try:
            planner_io.save_pickle_checked(_RUNNING_PKL, self.map_data)
            rospy.loginfo("[{}] Planner data saved.".format(rospy.get_caller_id()))
            # Site-native: nothing ever asks for an explicit "save planner data",
            # so keep saves/<site>.pkl in sync here. With it the next start /
            # switch back loads the zones from the pickle instead of regenerating
            # every zone from the bundle (AUDIT A4).
            key = None if self._legacy_maps() else self._planner_key()
            if key and self._raster_site == key:
                shutil.copyfile(_RUNNING_PKL, _saves_pkl(key) + '.tmp')
                os.replace(_saves_pkl(key) + '.tmp', _saves_pkl(key))
            return True
        except Exception as e:
            rospy.logerr("[{}] Planner data save failed: {}".format(
                rospy.get_caller_id(), e))
            return False

    def load_running_data(self, what=""):
        """Load the running planner_data pickle into self.map_data. Returns True
        only when a VALID workspace was loaded. A missing / empty (pickled None)
        / foreign pickle means "no saved data": map_data is left untouched and
        False is returned (loginfo, not an error)."""
        map_data, reason = planner_io.load_pickle_checked(
            _RUNNING_PKL, required_attrs=('zones', 'polygon_msgs', 'np_original',
                                          'resolution', 'initial_map'))
        if map_data is None:
            if reason == 'missing':
                rospy.loginfo("[{}] No running planner data yet.".format(
                    rospy.get_caller_id()))
            else:
                rospy.loginfo("[{}] Running planner data unusable ({}) — treated "
                              "as no saved data.".format(rospy.get_caller_id(), reason))
            return False
        prev = self.map_data
        try:
            self.map_data = map_data
            if self.map_data.planner_program_list_msg is None:
                self.map_data.planner_program_list_msg = PlannerProgramList()
                self.map_data.planner_program_list_msg.header.frame_id = "map"
                self.map_data.planner_program_list_msg.header.stamp = rospy.Time.now()
                self.map_data.planner_program_list_msg.program_list = []
            self.np_show = self.map_data.np_semi_assembled
            self.map_data_publisher()
            self.map_poly_list_publisher()
            self.map_zone_list_publisher()
            self.program_list_publisher()
            self.log_publisher("Planner data loaded{}".format(what))
            rospy.loginfo("[{}] Planner data loaded{}.".format(rospy.get_caller_id(), what))
            return True
        except Exception as e:
            self.map_data = prev
            rospy.logwarn("[{}] Planner data load failed: {}".format(
                rospy.get_caller_id(), e))
            return False


    def is_crossing_polygons(self, geom, polygons):
        """geom leaves the free space: no single outline polygon holds it. An
        obstacle or a map rule can cut a zone in parts; a connector inside one
        part is fine, it can never lie in all of them."""
        if not polygons:
            return False
        return not any(polygon.contains(geom) for polygon in polygons)

    def is_crossing_other_lines(self, conn_line, multilines, line_list=None):
        result = False
        if line_list is not None:
            multilines.append(line_list)
        for multiline in multilines:
            for line in multiline.geoms:
                # Exclude previous line for same point
                if line.coords[1][0] != conn_line.coords[0][0] and line.coords[1][1] != conn_line.coords[0][1]:
                    if line.intersects(conn_line):
                        result = True
                        return result
        return result

    def _program_not_found(self, name):
        """A select for a program the served site does not have (e.g. scheduled
        for another site): say so instead of staying silent."""
        if not self._programs_usable():
            # Not "not found": the list of the served site is not loaded yet.
            # Same text as the state notice, once per program per state entry.
            text = (self._programs_pending[1] if self._programs_pending else
                    "Programs not loaded: the programs of the active map are not "
                    "ready")
            if name not in self._programs_pending_told:
                self._programs_pending_told.add(name)
                self.log_publisher("{} — '{}' not started.".format(text, name))
                rospy.logwarn("[{}] {} — '{}' not started.".format(
                    rospy.get_caller_id(), text, name))
            return
        text = "Program '{}' not found on the active map".format(name)
        self.log_publisher(text)
        rospy.logwarn("[{}] {}.".format(rospy.get_caller_id(), text))

    def _program_with_current_zones(self, program_msg):
        """Copy of `program_msg` whose zones are the CURRENT workspace zones of
        the same names (fresh coverage paths after a map refresh / zone edit).
        Returns (program, None) or (None, reason) when the program cannot run:
        no zones, a zone no longer on the map, or a zone without mowing paths.
        A zone a map rule took the paths from is left out with a start note (the
        rule may be temporary); only when that leaves nothing the program refuses."""
        if not program_msg.zone_list:
            return None, "it has no zones — edit the program and add a zone"
        with self._workspace_lock:
            ws = {z.msg.name: z.msg for z in (self.map_data.zones if self.map_data else [])}
            zones = []
            notes = []
            for z in program_msg.zone_list:
                cur = ws.get(z.name)
                if cur is None:
                    return None, "zone '{}' is not on the active map".format(z.name)
                if not cur.paths:
                    rules = self._zone_rules(cur)
                    if not rules:
                        return None, "zone '{}' has no mowing paths".format(z.name)
                    notes.append(coverage_rules.start_note(
                        'zone_under_rule', program_msg.name, z.name, rule=rules[0]['name']))
                    continue
                height = coverage_rules.effective_cut_height(program_msg, cur.cut_height)
                if not coverage_rules.cut_height_ok(height):
                    return None, "cut height {} mm of zone '{}' is outside {}".format(
                        height, z.name, coverage_rules.cut_height_text())
                zones.append(copy.deepcopy(cur))
        if not zones:
            return None, "map rules leave no mowing path in any of its zones ({})".format(
                '; '.join(n['text_en'] for n in notes))
        self._add_start_notes(notes)
        program = copy.deepcopy(program_msg)
        program.zone_list = zones
        program.area = min(int(sum(z.area for z in zones)), 32767)
        program.length = min(int(sum(z.length for z in zones)), 32767)
        return program, None

    # ---- a checkpoint belongs to the paths it was taken on ------------------
    # last_result names a path by index, and regenerated zones (map edit, rule,
    # shape) number their paths anew. What the mission got is recorded at every
    # hand-over, so whatever happened since, and in whatever order the mission's
    # late write-backs came, a resume can tell. No record = cannot tell = the same
    # as different: mowing twice beats skipping.
    _RUN_PATHS_FILE = os.path.join(_RUNNING_DIR, 'planner_run_paths.json')

    def _run_paths_read(self):
        try:
            with open(self._RUN_PATHS_FILE) as f:
                data = json.load(f)
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def _run_paths_key(self, name):
        return '{}|||{}'.format(self._planner_key() or '', name)

    def _record_run_paths(self, program):
        """Hand-over to the mission: {zone: fingerprint of the paths it gets}."""
        self._run_paths[self._run_paths_key(program.name)] = {
            z.name: coverage_rules.path_fingerprint(z.paths) for z in program.zone_list}
        try:
            planner_io.write_json_atomic(self._RUN_PATHS_FILE, self._run_paths)
        except Exception as e:
            rospy.logwarn("[{}] Run paths not saved: {}".format(rospy.get_caller_id(), e))

    def _add_start_notes(self, notes):
        self._start_notes.extend(notes)
        for note in notes:
            self.chain_log("Program '{}': {}.".format(note['program'], note['text_en']))

    def start_notes(self):
        return list(self._start_notes)

    def _rebase_checkpoint(self, stored, program):
        """Before a resume: the mission skips every zone ahead of the checkpoint
        and every path ahead of it in that zone. Allowed only where the paths are
        the ones the stopped run had. Otherwise the resume starts at the first
        zone that changed. `stored` = the saved program, `program` = what the
        mission gets; both take the new checkpoint, so a restart cannot bring the
        old index back on the record of this hand-over."""
        found = run_path.parse_checkpoint(program.last_result)
        if not found:
            return
        zone = found[0]
        order = [z.name for z in stored.zone_list]
        if zone not in order:
            self._add_start_notes([coverage_rules.start_note(
                'checkpoint_zone_gone', program.name, zone)])
            return                  # the mission mows the whole program
        record = self._run_paths.get(self._run_paths_key(program.name)) or {}
        current = {z.name: z for z in program.zone_list}
        upto = order.index(zone) + 1
        target = None
        for name in order[:upto]:
            if (name in current and record.get(name)
                    != coverage_rules.path_fingerprint(current[name].paths)):
                target = name
                break
        if target is None:
            if zone in current:
                return              # the same paths: the checkpoint holds
            after = [n for n in order[upto:] if n in current]
            if not after:
                self._add_start_notes([coverage_rules.start_note(
                    'checkpoint_zone_gone', program.name, zone)])
                return
            target = after[0]       # its zone is left out: on with the next one
        else:
            self._add_start_notes([coverage_rules.start_note(
                'checkpoint_stale', program.name, target)])
        text = 'failed: on_path-{}-0-0'.format(target)
        program.last_result = stored.last_result = text
        self.save_programs()
        self.program_list_publisher()
        self._bundle_export_programs()

    def _select_on_map(self, name, verb, pub):
        """Hand a program of the map that is on to the mission. (True, None), or
        (False, reason) when it cannot run; (False, None) = no such program."""
        if self.permanent_program_list_msg is not None and self._programs_usable():
            for program_msg in self.permanent_program_list_msg.program_list:
                if program_msg.name == name:
                    self._start_notes = []
                    program, reason = self._program_with_current_zones(program_msg)
                    if program is None:
                        return False, reason
                    if verb == 'resume':
                        self._rebase_checkpoint(program_msg, program)
                    self._record_run_paths(program)
                    self.program_active = program
                    self.log_publisher("Program selected to {}: {}".format(verb, name))
                    rospy.loginfo("[{}] Program selected to {}: {}".format(rospy.get_caller_id(), verb, name))
                    pub.publish(self.program_active)
                    return True, None
        return False, None

    def _select_program(self, ref, verb, pub):
        """Every start of a program comes through here (UI, calendar, agent,
        resume). Its map goes on first, verified; the mission - and the undock -
        gets the program only afterwards (vitulus-field#46)."""
        if self._map_gate.busy():
            # Nothing may start under a map that is changing.
            running = self._map_gate.busy()
            name = program_map.parse_ref(ref)[1]
            if running and running['ref'] != ref:
                self._map_gate.refuse_busy(verb, ref, name, running['site'], running)
            return
        legacy = self._legacy_maps()
        plan = program_map.plan_start(
            ref, legacy, self._served_site, self.current_navi_map_name,
            self._usable_programs(), self._site_catalog)
        if (plan.kind == plan.DIRECT and plan.site and not legacy
                and program_map.needs_verify(self._navi_ready, plan.site, self._dock_status,
                                             self._map_gate.pose_tol_m)):
            plan.kind, plan.verify_only = plan.SWITCH, True
        if plan.kind == plan.REFUSE:
            self._map_gate.refuse(verb, ref, plan.name, plan.site, plan.code, **plan.params)
        elif plan.kind == plan.SWITCH:
            def start(name, verb_):
                ok, reason = self._select_on_map(name, verb_, pub)
                if not ok and reason is None:
                    reason = "it is not on the map after loading it"
                return ok, reason
            self._map_gate.submit(plan, ref, verb, legacy, start)
        else:
            ok, reason = self._select_on_map(plan.name, verb, pub)
            if ok:
                self._map_gate.ready(verb, ref, plan.name, plan.site)
            elif reason is not None:
                self._map_gate.refuse(verb, ref, plan.name, plan.site,
                                      'program_unusable', detail=reason)
            else:
                self._program_not_found(plan.name)

    def _usable_programs(self):
        """{name: map_name} of the list in memory, when it may be used."""
        if self.permanent_program_list_msg is None or not self._programs_usable():
            return {}
        return {p.name: p.map_name for p in self.permanent_program_list_msg.program_list}

    # ---- env of program_map.MapGate ----------------------------------------
    def now(self):
        return time.time()

    def sleep(self, seconds):
        time.sleep(seconds)

    def log(self, text):
        self.log_publisher(text)
        rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))

    def report(self, state):
        self.program_start_state_pub.publish(String(program_map.dumps(state)))

    def robot_state(self):
        return (self._dock_status, self._in_dock, self._mission_status,
                self._mission_busy, self._mapping_running)

    def status_seen(self):
        return self._site_catalog is not None

    def request_map(self, site, legacy_mode):
        """Ask for the map; returns the time stamp serve_error() compares with."""
        stamp = time.time()
        pub = self.serve_site_pub
        if legacy_mode:
            pub = (self.load_map_rtabmap_pub if program_map.legacy_is_indoor(site)
                   else self.load_map_pub)
        deadline = time.time() + 3.0
        while pub.get_num_connections() == 0 and time.time() < deadline:
            time.sleep(0.05)
        pub.publish(String(site))
        return stamp

    def serve_error(self, stamp):
        return self._serve_error if self._serve_error_t >= stamp else None

    def map_on(self, site, legacy_mode):
        if legacy_mode:
            return self.current_navi_map_name == site
        return self._served_site == site

    def planner_ready(self, site, legacy_mode):
        if legacy_mode:
            return self._planner_loaded == site and self.data_loaded
        # No lock: a load holds it for its whole length and Stop must get through.
        return (self._workspace_site == site and self._planner_loaded == site
                and self._programs_usable())

    def navi_state(self):
        return self._navi_ready

    def _select_chain(self, text, verb, pub):
        """A plain program, or a chain of them (program_chain.py)."""
        refs = program_chain.parse(text)
        if len(refs) < 2 or self.chain_program(text, None) is not None:
            self._select_program(text, verb, pub)
            return
        self._select_program(refs[0], verb, program_chain.ChainStart(self, refs, verb, pub))

    # ---- env of program_chain.ChainStart -----------------------------------
    def chain_program(self, name, site):
        """The listed program of this name on the map that is on, or None."""
        if self.permanent_program_list_msg is None or not self._programs_usable():
            return None
        for program in self.permanent_program_list_msg.program_list:
            if program.name == name and self._on_current_map(program) \
                    and site in (None, program.map_name, self._bundle_site()):
                return program
        return None

    def chain_current(self, program):
        current, reason = self._program_with_current_zones(program)
        if current is not None:
            self._record_run_paths(current)
        return current, reason

    def chain_id(self):
        return str(int(time.time() * 1000))

    def chain_log(self, text):
        self.log_publisher(text)
        rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))

    def callback_program_select(self, msg):
        self._select_chain(msg.data, "run", self.program_active_pub)

    def callback_program_select_resume(self, msg):
        self._select_chain(msg.data, "resume", self.program_active_unfinished_pub)

    def program_list_publisher(self):
        """ Publish program list """
        # print(self.map_data.planner_program_list_msg)
        if self.permanent_program_list_msg is not None:
            prog_list_msg_ordered = sorted(self.permanent_program_list_msg.program_list, key=lambda x: x.name.lower())
            self.permanent_program_list_msg.program_list = prog_list_msg_ordered
            if not self._programs_usable():
                # The list in memory belongs to ANOTHER site (swap pending): its
                # programs must not be listed / runnable on the served map.
                hidden = PlannerProgramList()
                hidden.header = self.permanent_program_list_msg.header
                self.program_list_pub.publish(hidden)
                return
            self._stamp_programs_owner()
            rospy.loginfo("[{}] Publishing program list: {} programs".format(
                rospy.get_caller_id(), len(self.permanent_program_list_msg.program_list)))
            self.program_list_pub.publish(self.permanent_program_list_msg)

    def _propagate_zone_to_programs(self, new_zone_msg):
        """Push an edited zone into every saved program that uses it.

        Programs embed a full copy of each zone (incl. its computed coverage
        paths), so a map edit would otherwise not reach existing programs. When
        a zone is re-saved we refresh that copy in place — matched by zone name
        within the same map (see _on_current_map) — and recompute
        the program's area/length totals. Returns the number of programs
        changed. A deep copy is stored so later in-memory zone edits don't alias
        back into the program until they are propagated too.
        """
        if self.permanent_program_list_msg is None or not self._programs_usable():
            return 0
        changed = 0
        for program in self.permanent_program_list_msg.program_list:
            if not self._on_current_map(program):
                continue
            hit = False
            for i in range(len(program.zone_list)):
                if program.zone_list[i].name == new_zone_msg.name:
                    program.zone_list[i] = copy.deepcopy(new_zone_msg)
                    hit = True
            if hit:
                program.area = int(sum(z.area for z in program.zone_list))
                program.length = int(sum(z.length for z in program.zone_list))
                changed += 1
        if changed:
            self.save_programs()
            self.program_list_publisher()
            self._bundle_export_programs()
            self.log_publisher("Zone '{}' update propagated to {} program(s).".format(new_zone_msg.name, changed))
            rospy.loginfo("[{}] Zone '{}' propagated to {} program(s).".format(rospy.get_caller_id(), new_zone_msg.name, changed))
        return changed

    def _remove_zone_from_programs(self, zone_name):
        """Drop a removed zone from every saved program that referenced it.

        Mirrors _propagate_zone_to_programs for zone deletion: scoped to the
        current map, recomputes area/length totals, and persists. Returns the
        number of programs changed.
        """
        if self.permanent_program_list_msg is None or not self._programs_usable():
            return 0
        changed = 0
        for program in self.permanent_program_list_msg.program_list:
            if not self._on_current_map(program):
                continue
            new_list = [z for z in program.zone_list if z.name != zone_name]
            if len(new_list) != len(program.zone_list):
                program.zone_list = new_list
                program.area = int(sum(z.area for z in program.zone_list))
                program.length = int(sum(z.length for z in program.zone_list))
                changed += 1
        if changed:
            self.save_programs()
            self.program_list_publisher()
            self._bundle_export_programs()
            self.log_publisher("Removed zone '{}' from {} program(s).".format(zone_name, changed))
            rospy.loginfo("[{}] Removed zone '{}' from {} program(s).".format(rospy.get_caller_id(), zone_name, changed))
        return changed

    # ======================================================================
    # Site-bundle (WP-C): dual-write zones/programs to ~/.vitulus/mapping_v3/
    # <site>/ in UTM, alongside the legacy pickles. bundle-wins on load.
    # All entry points are try/except-guarded — they NEVER break legacy paths.
    # ======================================================================
    def _bundle_site(self):
        """Resolve (and cache) the bundle site for the active navi map. Returns
        the site name or None. loginfo-once when no site resolves."""
        if not _BUNDLE_OK:
            return None
        # site-native (legacy_maps=False, delegacy 2026-07-19): the bundle site is
        # the CURRENTLY SERVED mapping-v3 site (not a manifest.navi_map match on
        # active_map='SITE'). ~bundle_site still overrides.
        if not self._legacy_maps():
            if self._bundle_site_override:
                return (self._bundle_site_override
                        if vbundle.site_exists(self._bundle_site_override) else None)
            return self._served_site
        m = self.current_navi_map_name
        if not m or m == "New":
            return None
        if self._bundle_site_key == m:
            return self._bundle_site_cache
        site = None
        try:
            site = bundle_sync.resolve_site(m, self._bundle_site_override)
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: resolve failed: {}".format(rospy.get_caller_id(), e))
        self._bundle_site_key = m
        self._bundle_site_cache = site
        if site:
            rospy.loginfo("[{}] Site bundle active: '{}' <- navi map '{}'".format(rospy.get_caller_id(), site, m))
            self._bundle_off_logged = False
        elif not self._bundle_off_logged:
            rospy.loginfo("[{}] Site bundle: no manifest links navi map '{}' — bundle persistence off.".format(rospy.get_caller_id(), m))
            self._bundle_off_logged = True
        return site

    def _active_map_datum(self):
        """Canonical map<->UTM datum of the ACTIVE navi map (drives the live
        utm<->map TF). Read from the map's maps_data pickle; fall back to the
        site datum.yaml. Returns a canonical datum dict or None."""
        m = self.current_navi_map_name
        if not m:
            return None
        path = os.path.join(_VITULUS_DIR, 'saves', 'maps_data', m + '.pkl')
        try:
            if exists(path):
                with open(path, 'rb') as f:
                    md = pickle.load(f)
                if md.is_utm():
                    return vgeo.from_pickle_datum(md)
                rospy.logwarn("[{}] Site bundle: map '{}' pickle has no UTM datum.".format(rospy.get_caller_id(), m))
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: datum load failed: {}".format(rospy.get_caller_id(), e))
        # fallback: refined site datum.yaml
        site = self._bundle_site()
        if site:
            try:
                dp = os.path.join(vbundle.site_dir(site), "datum.yaml")
                if exists(dp):
                    import yaml
                    with open(dp) as f:
                        dd = yaml.safe_load(f)
                    return vgeo.from_datum_yaml(dd)
            except Exception as e:
                rospy.logwarn("[{}] Site bundle: datum.yaml fallback failed: {}".format(rospy.get_caller_id(), e))
        return None

    def _workspace_is_of(self, site, what):
        """Site-native: the in-memory workspace may be written into `site`'s
        bundle only when it was built FOR that site. The served site can change
        while a zone save / live refresh of the previous site is still running —
        its zones (converted with the wrong datum) must never reach this bundle,
        where the merge export would keep them forever."""
        # (compared with the SERVED site: `site` may be a ~bundle_site override)
        if self._legacy_maps() or self._raster_site == self._planner_key():
            return True
        rospy.logwarn("[{}] Site bundle: workspace belongs to site '{}', not to "
                      "'{}' — {}.".format(rospy.get_caller_id(), self._raster_site,
                                          site, what))
        return False

    def _bundle_export_zones(self):
        """Mirror the workspace zones (map_data.zones) into zones.geojson (UTM)."""
        site = self._bundle_site()
        if not site or self.map_data is None:
            return
        if not self._workspace_is_of(site, "zones NOT exported"):
            return
        try:
            datum = self._active_map_datum()
            if datum is None:
                rospy.logwarn("[{}] Site bundle: no datum — skipping zones export.".format(rospy.get_caller_id()))
                return
            bzones = []
            for zone in self.map_data.zones:
                zmsg = zone.msg
                poly_xy = [(p.x, p.y) for p in zmsg.polygon.polygon.points]
                if len(poly_xy) < 3:
                    continue
                props = {f: getattr(zmsg, f, None) for f in bundle_sync.ZONE_PROP_FIELDS}
                bzones.append(bundle_sync.zone_to_bundle(zmsg.name, poly_xy, props, datum))
            # MERGE export (2026-07-19): the workspace may legitimately hold
            # fewer zones than the bundle (zones outside current raster coverage
            # cannot regenerate). Workspace zones win by name; bundle-only zones
            # are preserved so a partial-coverage session can never clobber the
            # full garden set.
            existing = {z.get('name'): z for z in (vbundle.load_zones(site) or [])}
            for z in bzones:
                existing[z.get('name')] = z
            merged = list(existing.values())
            if not merged:
                return
            bundle_sync.apply_effective(merged, vbundle.load_programs(site) or [])
            vbundle.save_zones(site, merged)  # utm_zone from manifest
            self._touch_bundle_stamp(site, 'zones')  # own write != external edit (A4)
            rospy.loginfo("[{}] Site bundle: exported {} zone(s) to '{}'.".format(rospy.get_caller_id(), len(bzones), site))
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: zones export failed: {}".format(rospy.get_caller_id(), e))

    def _bundle_remove_zone(self, name):
        """AUDIT A2 (2026-08-01): explicit delete path for the merge-export
        world. Removes the zone by name from zones.geojson so the by-name merge
        (which intentionally preserves bundle-only zones) cannot bring it back."""
        site = self._bundle_site()
        if not site:
            return
        if not self._workspace_is_of(site, "zone '{}' NOT deleted".format(name)):
            return
        try:
            existing = vbundle.load_zones(site) or []
            kept = [z for z in existing if z.get('name') != name]
            if len(kept) == len(existing):
                return
            vbundle.save_zones(site, kept)
            self._touch_bundle_stamp(site, 'zones')
            rospy.loginfo("[{}] Site bundle: zone '{}' DELETED from '{}'.".format(
                rospy.get_caller_id(), name, site))
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: zone delete failed: {}".format(
                rospy.get_caller_id(), e))

    # AUDIT A4 (2026-08-01): the old freshness test compared bundle mtimes to
    # saves/<key>.pkl, which normal operation never touches -> the bundle was
    # perpetually "newer" and EVERY load re-imported + regenerated all zones.
    # A stamp file records the bundle mtime last seen by an import OR written
    # by our own export, so re-import happens only on genuinely external edits.
    _BUNDLE_STAMP = os.path.join(_RUNNING_DIR, 'bundle_import_stamp.json')

    # Site-native program ownership. The program pickle is ONE global file while
    # active_map is the constant 'SITE' (data older than vitulus-field#46 carry
    # it, or 'New', in PlannerProgram.map_name), so the
    # pickle alone cannot tell which site its programs belong to. This sidecar
    # records it; the per-site authority is <site>/programs.yaml in the bundle.
    _PROGRAMS_SITE_FILE = os.path.join(_RUNNING_DIR, 'planner_programs_site.json')

    def _programs_site_read(self):
        """(owner_site, untrusted). untrusted=True: a swap was interrupted
        between the transition marker and the final one."""
        try:
            with open(self._PROGRAMS_SITE_FILE) as f:
                data = json.load(f)
            # A transition with an empty 'from' is the very FIRST swap (owner
            # unknown): the pickle may still be the only copy of its programs,
            # so it stays adoptable instead of being dropped as untrusted.
            transition = data.get('transition') or {}
            return (data.get('site') or None), bool(transition.get('from'))
        except Exception:
            return None, False

    def _programs_site_write(self, site, transition=None):
        """Atomic. `transition`=(from, to) marks a swap in progress (site=None);
        the final marker is written only after the pickle holds the new list."""
        self._programs_site = site
        self._programs_untrusted = transition is not None
        try:
            data = {'site': site}
            if transition is not None:
                data['transition'] = {'from': transition[0], 'to': transition[1]}
            planner_io.write_json_atomic(self._PROGRAMS_SITE_FILE, data)
            return True
        except Exception as e:
            rospy.logwarn("[{}] programs-site sidecar write failed: {}".format(
                rospy.get_caller_id(), e))
            return False

    def _bundle_stamp_get(self, site, kind):
        try:
            with open(self._BUNDLE_STAMP) as f:
                return float(json.load(f).get(site, {}).get(kind, 0.0))
        except Exception:
            return 0.0

    def _touch_bundle_stamp(self, site, kind):
        try:
            data = {}
            if exists(self._BUNDLE_STAMP):
                with open(self._BUNDLE_STAMP) as f:
                    data = json.load(f)
            t = vbundle.file_mtime(site, kind)
            data.setdefault(site, {})[kind] = t if t is not None else time.time()
            with open(self._BUNDLE_STAMP, 'w') as f:
                json.dump(data, f)
        except Exception as e:
            rospy.logwarn_throttle(60.0, "[{}] bundle stamp write failed: {}".format(
                rospy.get_caller_id(), e))

    def _programs_pending_notice(self, site, text):
        """The served site's programs could not be loaded (list hidden, selects
        refused). Tell the operator ONCE per state entry — the load is retried
        often and master_controller re-sends its select on every idle check."""
        if self._programs_pending == (site, text):
            return
        self._programs_pending = (site, text)
        self._programs_pending_told = set()
        self.log_publisher(text)
        rospy.logerr("[{}] {} (retried on the next site_map / reload).".format(
            rospy.get_caller_id(), text))

    def _programs_pending_clear(self):
        self._programs_pending = None
        self._programs_pending_told = set()

    def _programs_usable(self):
        """Site-native: the in-memory program list may be listed / run / edited /
        exported only when it BELONGS to the served site. While a swap to the
        served site is pending (its zones are not ready yet) the list still
        holds another site's programs — their paths are in THAT site's map
        frame, so they must be neither runnable nor written into this bundle."""
        if self._legacy_maps():
            return True
        site = self._bundle_site()
        if not site:
            return True     # nothing served / bundle off: global list as before
        return self._programs_site == site and not self._programs_need_import

    @staticmethod
    def _legacy_tagged(program):
        """Legacy programs carry "<name>***env*<ENV>" in map_name."""
        return '***env*' in (program.map_name or '')

    def _on_current_map(self, program):
        """The program belongs to the map the list is used on. Site-native: the
        list in memory IS the owner site's list, so every program without the
        legacy marker belongs to it, whatever its map_name says (data written
        before vitulus-field#46 carry 'SITE' or 'New' — navi_man's active_map
        at the time of the save). Legacy mode / legacy tag: map_name must equal
        the active navi map, as before."""
        if not self._legacy_maps() and not self._legacy_tagged(program):
            return True
        return program.map_name == self.current_navi_map_name

    def _program_map_tag(self, site):
        """map_name of a program of `site`. Site-native: the site name — the
        program carries the map it belongs to (vitulus-field#46). Legacy: the
        active navi map name."""
        if not self._legacy_maps() and site:
            return site
        return self.current_navi_map_name

    def _stamp_programs_owner(self):
        """Site-native: every program of the list in memory names its owner
        site in map_name (older data carry 'SITE' / 'New'). In memory only; the
        next save persists it. Legacy-tagged programs are left alone."""
        site = self._programs_site
        if (self._legacy_maps() or not site
                or self.permanent_program_list_msg is None):
            return
        for program in self.permanent_program_list_msg.program_list:
            if not self._legacy_tagged(program) and program.map_name != site:
                program.map_name = site

    def _bundle_export_programs(self, allow_empty=False, site=None, only_missing=False):
        """Mirror active-map programs into programs.yaml (metadata + zone_names).
        Programs for OTHER maps live only in the global pickle and are NOT
        written here (a site links to exactly one navi map).
        allow_empty: the operator really removed the last program.
        site: export to THIS site (the pre-swap save of the old owner's list)
        instead of the served one. only_missing: only ADD programs the yaml does
        not hold yet (the yaml was edited externally — never clobber it).
        Returns True when the site's programs.yaml holds the list afterwards."""
        explicit = site is not None
        site = site or self._bundle_site()
        if not site or self.permanent_program_list_msg is None:
            return False
        if not explicit and not self._programs_usable():
            # The in-memory list belongs to another site (swap pending) or was
            # never loaded — never write it into THIS site's bundle.
            rospy.logwarn("[{}] Site bundle: program list in memory (site '{}') is "
                          "not the list of '{}' — NOT exported.".format(
                              rospy.get_caller_id(), self._programs_site, site))
            return False
        try:
            existing = vbundle.load_programs(site) or []
            prev = {(pd.get('name', '') or ''): pd for pd in existing}
            bundle_zone_names = [z.get('name') for z in (vbundle.load_zones(site) or [])]
            # Zones the workspace holds; None = workspace of that site unknown.
            ws_names = None
            if (not explicit and self.map_data is not None
                    and (self._legacy_maps() or self._raster_site == site)):
                ws_names = [z.msg.name for z in self.map_data.zones]
            progs = []
            for p in self.permanent_program_list_msg.program_list:
                # NOTE (2026-07-19): no map_name filter. All field programs carry
                # the legacy tag '2025_06***env*OUTDOOR'; filtering on the active
                # map exported an EMPTY list on every save and clobbered the
                # migrated programs.yaml. One garden = one program set.
                if only_missing and p.name in prev:
                    continue
                # MERGE (same rule as the zones export): a zone the program lost
                # only because the workspace cannot hold it right now (raster not
                # built / zone outside coverage) stays in the yaml.
                zone_names = planner_io.merge_zone_names(
                    (prev.get(p.name) or {}).get('zone_names'),
                    [z.name for z in p.zone_list], ws_names, bundle_zone_names)
                scalars = {f: getattr(p, f, None) for f in bundle_sync.PROGRAM_SCALAR_FIELDS}
                progs.append(bundle_sync.program_to_bundle(p.name, zone_names, scalars))
            if only_missing:
                if not progs:
                    return True
                progs = list(existing) + progs
            if not progs and not allow_empty and existing:
                rospy.logwarn('[%s] Site bundle: refusing to overwrite non-empty '
                              'programs.yaml with an EMPTY export.' % rospy.get_caller_id())
                return False
            vbundle.save_programs(site, progs)
            self._touch_bundle_stamp(site, 'programs')  # own write != external edit (A4)
            rospy.loginfo("[{}] Site bundle: exported {} program(s) to '{}'.".format(rospy.get_caller_id(), len(progs), site))
            self._bundle_refresh_effective(site, progs)
            return True
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: programs export failed: {}".format(rospy.get_caller_id(), e))
            return False

    def _bundle_refresh_effective(self, site, progs):
        """A program edit can change what a zone really gets: keep props.effective
        in zones.geojson true (map_objects_server reads it from there). Never
        fails the programs export."""
        try:
            bzones = vbundle.load_zones(site) or []
            if bundle_sync.apply_effective(bzones, progs):
                vbundle.save_zones(site, bzones)
                self._touch_bundle_stamp(site, 'zones')
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: effective zone values not updated: "
                          "{}".format(rospy.get_caller_id(), e))

    def _bundle_build_zone_msg(self, name, poly_xy, props):
        """Construct a MapEditZone from a map-frame polygon + bundle props.
        paths/area/length are (re)computed by _regenerate_zone from these."""
        z = MapEditZone()
        z.header.frame_id = "map"
        z.name = name or ""
        z.type = str(props.get('type', '') or '')
        z.border_paths = int(props.get('border_paths', 0) or 0)
        z.coverage_angle = int(props.get('coverage_angle', 0) or 0)
        z.paths_distance = float(props.get('paths_distance', 0.0) or 0.0)
        z.simplify = float(props.get('simplify', 0.0) or 0.0)
        z.cut_height = int(props.get('cut_height', 0) or 0)
        z.rpm = int(props.get('rpm', 0) or 0)
        z.area = int(props.get('area', 0) or 0)
        z.length = int(props.get('length', 0) or 0)
        ps = PolygonStamped()
        ps.header.frame_id = "map"
        for (x, y) in poly_xy:
            ps.polygon.points.append(Point32(float(x), float(y), 0.0))
        z.polygon = ps
        return z

    def _bundle_import_zones(self, site, datum):
        """Rebuild the workspace zones from zones.geojson (UTM -> map) and
        REGENERATE coverage via _regenerate_zone (the same code path save_zone
        uses). Consistency guard warns when regen area/length drift > 5%."""
        bzones = vbundle.load_zones(site)
        self.map_data.zones = []
        n = 0
        for bz in bzones:
            poly_xy = bundle_sync.bundle_to_polygon_map(bz, datum)
            if len(poly_xy) < 3:
                continue
            props = bz.get('props', {}) or {}
            zmsg = self._bundle_build_zone_msg(bz.get('name'), poly_xy, props)
            try:
                zone = self._regenerate_zone(zmsg)
            except Exception as e:
                rospy.logwarn("[{}] Site bundle: zone '{}' regen failed: {}".format(rospy.get_caller_id(), bz.get('name'), e))
                continue
            for metric in ('area', 'length'):
                rel = bundle_sync.rel_mismatch(getattr(zone.msg, metric), props.get(metric))
                if rel is not None:
                    rospy.logwarn("[{}] Site bundle: zone '{}' {} drifted {:.0f}% on regen (stored {} -> regen {}) — mower coverage differs.".format(
                        rospy.get_caller_id(), bz.get('name'), metric, rel * 100.0, props.get(metric), getattr(zone.msg, metric)))
            n += 1
        self.current_zone = None
        self.save_running_data()
        rospy.loginfo("[{}] Site bundle: imported {} zone(s) from '{}'.".format(rospy.get_caller_id(), n, site))

    def _bundle_build_programs(self, site, adopt_unknown=False):
        """Build (NO side effects) the program list for `site` from its
        programs.yaml, snapshotting a deep copy (incl. fresh paths) of each
        workspace zone by name. Returns (program_list, adopted_names).
        Programs for OTHER maps (legacy tags, global pickle) are merged in
        untouched. Site-native: site programs (_on_current_map) that are NOT in
        this site's programs.yaml belong to another site and are left out —
        unless adopt_unknown (owner site of the pickle unknown, i.e. data older
        than the ownership sidecar): then they are kept, so an upgrade never
        loses a program."""
        bprogs = vbundle.load_programs(site)
        tag = self._program_map_tag(site)
        zone_by_name = {z.msg.name: z for z in (self.map_data.zones if self.map_data else [])}
        # AUDIT A3 (2026-08-01): dedupe by NAME across map tags. Export writes
        # ALL programs regardless of map_name; keeping other-tag programs whose
        # name the bundle also carries would duplicate every legacy-tagged
        # program on each import (and program_select takes the first name hit).
        # ...and dedupe the bundle list itself by name (last wins) — a pre-fix
        # export had already written duplicated entries to programs.yaml.
        bprogs = list({(pd.get('name', '') or ''): pd for pd in bprogs}.values())
        bundle_names = {(pd.get('name', '') or '') for pd in bprogs}
        kept = [p for p in self.permanent_program_list_msg.program_list
                if not self._on_current_map(p) and p.name not in bundle_names]
        adopted = []
        if adopt_unknown:
            adopted = [p for p in self.permanent_program_list_msg.program_list
                       if self._on_current_map(p) and p.name not in bundle_names]
            if adopted:
                rospy.logwarn("[{}] Site bundle: {} program(s) of unknown site "
                              "adopted by '{}': {}".format(
                                  rospy.get_caller_id(), len(adopted), site,
                                  [p.name for p in adopted]))
        new_progs = []
        for pd in bprogs:
            prg = PlannerProgram()
            prg.header.frame_id = "map"
            prg.name = pd.get('name', '') or ''
            prg.map_name = tag
            prg.speed = pd.get('speed') if pd.get('speed') in ('slow', 'mid', 'fast') else 'mid'
            prg.rpm = int(pd.get('rpm', 0) or 0)
            prg.cut_height = int(pd.get('cut_height', 0) or 0)
            prg.override_zone = bool(pd.get('override_zone', False))
            prg.last_result = str(pd.get('last_result', '') or '')
            prg.last_duration_minutes = int(pd.get('last_duration_minutes', 0) or 0)
            zl = []
            missing = []
            for zn in (pd.get('zone_names', []) or []):
                z = zone_by_name.get(zn)
                if z is not None:
                    zl.append(copy.deepcopy(z.msg))
                else:
                    missing.append(zn)
            prg.zone_list = zl
            prg.area = int(sum(z.area for z in zl))
            prg.length = int(sum(z.length for z in zl))
            if missing:
                rospy.logwarn("[{}] Site bundle: program '{}' references missing zone(s): {}".format(rospy.get_caller_id(), prg.name, missing))
            new_progs.append(prg)
        rospy.loginfo("[{}] Site bundle: {} program(s) read from '{}' ({} other-map, "
                      "{} adopted program(s) kept).".format(
                          rospy.get_caller_id(), len(new_progs), site, len(kept), len(adopted)))
        return kept + adopted + new_progs, [p.name for p in adopted]

    def _bundle_import_programs(self, site, adopt=False):
        """Replace the program list with the one built from `site`'s
        programs.yaml (same owner site — see _swap_programs for a site change).
        adopt: the pickle was not the authoritative copy (recovered from .BACK):
        keep its programs the yaml does not know and add them to the yaml."""
        new_list, adopted = self._bundle_build_programs(site, adopt_unknown=adopt)
        self.permanent_program_list_msg.program_list = new_list
        self.save_programs()  # persist merged set to the global pickle
        if adopted:
            self._bundle_export_programs(site=site, only_missing=True)

    def _swap_programs(self, site):
        """Site-native: make the in-memory program list the list of `site`.
        Call ONLY when the workspace zones of `site` are ready (the programs
        snapshot their zones from it). Crash-safe order, nothing is ever only in
        memory when it gets dropped:
          1. the old owner's list is written to ITS programs.yaml — or the swap
             is REFUSED (the list stays hidden, retried on the next load),
          2. transition marker (the pickle is about to change hands),
          3. new list -> memory + pickle (.BACK keeps the previous generation),
          4. adopted programs (unknown owner) -> this site's programs.yaml,
          5. final ownership marker.
        Returns True when the list now belongs to `site`."""
        owner = self._programs_site
        mem = self.permanent_program_list_msg.program_list
        # untrusted (interrupted swap): the old owner's yaml was already written
        # by that attempt and the pickle may hold either list -> nothing to save.
        if owner and owner != site and mem and not self._programs_untrusted:
            if vbundle.site_exists(owner):
                p_bt = vbundle.file_mtime(owner, 'programs')
                # yaml edited externally / pickle recovered from .BACK: the yaml
                # is the better copy — only ADD what it does not hold.
                add_only = (self._programs_need_import
                            or (p_bt is not None
                                and p_bt > self._bundle_stamp_get(owner, 'programs')))
                if not self._bundle_export_programs(site=owner, only_missing=add_only):
                    rospy.logerr("[{}] Program list of '{}' could not be written to "
                                 "its site bundle — NOT swapping to '{}' (programs "
                                 "stay hidden until it succeeds).".format(
                                     rospy.get_caller_id(), owner, site))
                    return False
            else:
                rospy.logwarn("[{}] Owner site '{}' of the program list no longer "
                              "exists — its programs are dropped.".format(
                                  rospy.get_caller_id(), owner))
        new_list, adopted = self._bundle_build_programs(
            site, adopt_unknown=(owner is None and not self._programs_untrusted))
        if not self._programs_site_write(None, transition=(owner, site)):
            self._programs_site_write(owner)     # memory state back; disk unchanged
            return False
        self.permanent_program_list_msg.program_list = new_list
        self._programs_need_import = False
        saved = self.save_programs()
        # From here on the list in memory IS the list of `site`.
        self._programs_site = site
        self._programs_untrusted = False
        if adopted:
            self._bundle_export_programs(site=site, only_missing=True)
        if saved:
            self._programs_site_write(site)
        self._touch_bundle_stamp(site, 'programs')    # A4: seen it
        self._programs_pending_clear()
        rospy.loginfo("[{}] Program list swapped to served site '{}' (was '{}').".format(
            rospy.get_caller_id(), site, owner))
        return True

    def _bundle_import_if_newer(self, force=False):
        """bundle-wins: when zones.geojson / programs.yaml are newer than the
        corresponding pickles, rebuild workspace zones/programs from the bundle.
        Any error is logged and the pickle state is kept.
        force (site-native, a newly served site with NO saved pickle): import the
        zones whenever the bundle has any.
        Programs are rebuilt from the workspace zones, so they are imported /
        swapped ONLY when those zones are ready (import succeeded, or the bundle
        has no zones) — a program rebuilt against a missing workspace would get
        an empty zone list and the next export would write that into the yaml.
        Returns True when the workspace zones are in sync with the bundle."""
        site = self._bundle_site()
        if not site:
            return True
        zones_ok = False
        try:
            # site-native: pickle keyed on the served site (active_map is 'SITE').
            active = self._planner_key() or self.current_navi_map_name
            map_pkl = _saves_pkl(active)
            prog_pkl = _PROGRAMS_PKL
            map_mtime = os.path.getmtime(map_pkl) if exists(map_pkl) else 0.0
            prog_mtime = os.path.getmtime(prog_pkl) if exists(prog_pkl) else 0.0
            z_bt = vbundle.file_mtime(site, 'zones')
            p_bt = vbundle.file_mtime(site, 'programs')
            # AUDIT A4: also honour the import/export stamp — the pkl mtimes
            # above never advance in normal operation, which made the bundle
            # perpetually "newer" and re-imported+regenerated on every load.
            z_seen = max(map_mtime, self._bundle_stamp_get(site, 'zones'))
            p_seen = max(prog_mtime, self._bundle_stamp_get(site, 'programs'))
            has_bundle_zones = z_bt is not None and bool(vbundle.load_zones(site))
            zones_newer = has_bundle_zones and (force or z_bt > z_seen)
            imported = False
            if zones_newer:
                datum = self._active_map_datum()
                if datum is None:
                    rospy.logwarn("[{}] Site bundle: newer than pickle but no datum — keeping pickle state.".format(rospy.get_caller_id()))
                elif self.map_data is None:
                    rospy.logwarn("[{}] Site bundle: zones newer but no map raster loaded — skipping zones import.".format(rospy.get_caller_id()))
                else:
                    self._bundle_import_zones(site, datum)
                    self._touch_bundle_stamp(site, 'zones')   # A4: seen it
                    zones_ok = imported = True
            else:
                zones_ok = (self.map_data is not None) or not has_bundle_zones

            programs_swap = not self._legacy_maps() and self._programs_site != site
            programs_newer = (self._programs_need_import
                              or (p_bt is not None and p_bt > p_seen))
            if (programs_swap or programs_newer) and not zones_ok:
                self._programs_pending_notice(
                    site, "Programs not loaded: zones or datum of map '{}' are not "
                          "ready".format(site))
            elif programs_swap:
                if self._swap_programs(site):
                    imported = True
                else:
                    self._programs_pending_notice(
                        site, "Programs not loaded: the program list of map '{}' "
                              "could not be saved to its site bundle".format(
                                  self._programs_site))
            elif programs_newer:
                self._bundle_import_programs(site, adopt=self._programs_need_import)
                self._programs_need_import = False
                self._programs_pending_clear()
                self._touch_bundle_stamp(site, 'programs')    # A4: seen it
                imported = True
            if imported:
                # Republish latched lists after an import.
                self.map_poly_list_publisher()
                self.map_zone_list_publisher()
                self.program_list_publisher()
        except Exception as e:
            rospy.logwarn("[{}] Site bundle: import-if-newer failed: {} — keeping pickle state.".format(rospy.get_caller_id(), e))
        return zones_ok

    # ======================================================================
    # Site-native mode (flag-gated, DEFAULT OFF): use the served mapping-v3
    # site raster as the zone-generation workspace instead of the legacy raster.
    # ======================================================================
    def _site_native(self):
        """site_native flag. Authoritative source is navi_manager.yaml (navi_man
        loads it the same way and does NOT expose it on the param server); a
        /navi_manager/site_native rosparam, if present, overrides. Cached."""
        ov = rospy.get_param('/navi_manager/site_native', None)
        if ov is not None:
            return bool(ov)
        if self._site_native_cached is None:
            val = False
            try:
                import yaml
                with open(_NAVI_MANAGER_YAML) as f:
                    cfg = yaml.load(f, Loader=yaml.Loader)
                val = bool(cfg.get('site_native', False))
            except Exception as e:
                rospy.logwarn("[{}] site_native: could not read navi_manager.yaml "
                              "({}) — assuming false.".format(rospy.get_caller_id(), e))
            self._site_native_cached = val
        return self._site_native_cached

    def _legacy_maps(self):
        """legacy_maps flag (delegacy 2026-07-19). Authoritative source is
        navi_manager.yaml (navi_man owns it, does NOT expose it on the param
        server); a /navi_manager/legacy_maps rosparam overrides. DEFAULT False
        (site-native, no legacy navi map). Cached."""
        ov = rospy.get_param('/navi_manager/legacy_maps', None)
        if ov is not None:
            return bool(ov)
        if self._legacy_maps_cached is None:
            val = False
            try:
                import yaml
                with open(_NAVI_MANAGER_YAML) as f:
                    cfg = yaml.load(f, Loader=yaml.Loader)
                val = bool(cfg.get('legacy_maps', False))
            except Exception as e:
                rospy.logwarn("[{}] legacy_maps: could not read navi_manager.yaml "
                              "({}) — assuming false.".format(rospy.get_caller_id(), e))
            self._legacy_maps_cached = val
        return self._legacy_maps_cached

    def _planner_key(self):
        """Base name for the planner_data pickle + the resolved bundle site.
        site-native (legacy_maps=False): the SERVING mapping-v3 site (decoupled
        from active_map, which is the constant 'SITE'); may be None until a site
        is served. Legacy: the active navi map name."""
        if not self._legacy_maps():
            return self._served_site
        return self.current_navi_map_name

    def callback_mapping_status(self, msg):
        """Track the served mapping-v3 site from /mapping_manager/status. On a
        serving-site CHANGE (site-native mode) reload the planner data keyed on
        the new site: swap bundle authority, rebuild the raster from its site_map
        and import zones/programs. Legacy mode: tracked but inert."""
        try:
            data = json.loads(msg.data)
        except Exception:
            return
        catalog = program_map.catalog_from_status(data)
        if catalog is not None:
            self._site_catalog = catalog
        self._mapping_running = bool(data.get('running'))
        self._serve_error = data.get('serve_error')
        self._serve_error_t = float(data.get('serve_error_t') or 0.0)
        serving = data.get('serving') or {}
        site = serving.get('site') if isinstance(serving, dict) else None
        if site == self._served_site:
            return
        # Under the workspace lock: a zone save / live refresh in flight finishes
        # (and exports) for the site it was started on before the site flips.
        with self._workspace_lock:
            prev = self._served_site
            self._served_site = site
            self._programs_pending_clear()
            # active_map is 'SITE' constant in site-native, so invalidate the
            # active-map-keyed bundle cache too (it keys on current_navi_map_name).
            self._bundle_site_key = None
            self._bundle_site_cache = None
            rospy.loginfo("[{}] Served site changed {!r} -> {!r}.".format(
                rospy.get_caller_id(), prev, site))
            if self._legacy_maps():
                return
            # The shown program / zone preview belong to the previous site's map.
            self._clear_markers_for_map_change()
            if not site:
                self._drop_workspace()
            elif self.current_navi_map_name not in (None,):
                # Reload planner data for the newly served site (same path a map
                # change would take). current_navi_map_name stays 'SITE'.
                self.callback_load_planner_data(Bool(True))

    def _rebuild_map_from_site_grid(self, carry=True):
        """site_native (2): rebuild the workspace raster (map_data.initial_map +
        np layers) from the served /mapping_manager/site_map grid instead of the
        legacy raster baked into planner_data.pkl — reusing the SAME MapData +
        assemble_map build path callback_map uses. Zones/polygons/programs are
        carried over (they come from the bundle / operator edits). No site_map ->
        keep the legacy raster + logwarn. Flag off -> no-op. Returns True if the
        raster was rebuilt."""
        if not self._site_native():
            return False
        try:
            grid = rospy.wait_for_message('/mapping_manager/site_map',
                                          OccupancyGrid, timeout=5.0)
        except Exception as e:
            rospy.logwarn("[{}] site_native: no /mapping_manager/site_map within "
                          "timeout ({}) — keeping legacy raster.".format(
                              rospy.get_caller_id(), e))
            return False
        return self._rebuild_workspace_from_grid(grid, carry=carry)

    def _rebuild_workspace_from_grid(self, grid, carry=True):
        """Core raster rebuild shared by the load-time fetch
        (_rebuild_map_from_site_grid) and the live refresh (callback_site_map).
        Builds a fresh MapData from `grid`, carries the existing workspace
        (zones/programs/polygons/assemble params) over it, and re-assembles.
        Empty grid or build error -> keep the previous raster + logwarn, return
        False. Returns True on a successful rebuild. Does NOT re-fetch or check
        the site_native flag (callers do). carry=False builds a CLEAN workspace
        (a newly served site must not inherit the previous site's zones)."""
        if grid.info.width * grid.info.height == 0:
            rospy.logwarn("[{}] site_native: served site_map is empty — keeping "
                          "legacy raster.".format(rospy.get_caller_id()))
            return False
        prev = self.map_data   # AUDIT #11: restore point (assemble may half-fail)
        try:
            arr = np.array(grid.data, dtype=np.int8).reshape(
                (grid.info.height, grid.info.width))
            new_map = MapData(np_map=arr, map_msg=grid)
            if self.map_data is not None and carry:
                # carry the workspace over the fresh raster: zones/programs are
                # bundle-owned, polygons + assemble params are operator edits.
                # AUDIT #11: copy the list — aliasing made error-restore return
                # a workspace whose zones were already regenerated (shared list)
                new_map.zones = list(self.map_data.zones)
                new_map.polygon_msgs = self.map_data.polygon_msgs
                new_map.planner_program_list_msg = self.map_data.planner_program_list_msg
                new_map.obstacle_margin = self.map_data.obstacle_margin
                new_map.obstacle_margin_px = self.map_data.obstacle_margin_px
                new_map.fill_hole_px = self.map_data.fill_hole_px
                new_map.fill_shape = self.map_data.fill_shape
                new_map.fill_shape_cv = self.map_data.fill_shape_cv
            self.map_data = new_map
            self.assemble_map()
            self.np_show = self.map_data.np_semi_assembled
            rospy.loginfo("[{}] site_native: workspace raster rebuilt from "
                          "/mapping_manager/site_map ({}x{} @ {:.3f} m).".format(
                              rospy.get_caller_id(), grid.info.width,
                              grid.info.height, grid.info.resolution))
            return True
        except Exception as e:
            self.map_data = prev   # AUDIT #11: drop the half-built workspace
            rospy.logwarn("[{}] site_native: rebuild from site_map failed ({}) — "
                          "keeping legacy raster.".format(rospy.get_caller_id(), e))
            return False

    # ----- site_native live refresh (debounce -> single worker, coalesced) ----
    def _grid_fingerprint(self, grid):
        """Cheap identity of a site_map grid: geometry + a hash of the cells.
        Used to skip refreshes when an identical grid is (re)latched."""
        try:
            h = hashlib.md5()
            info = grid.info
            h.update("{}x{}|{:.4f}|{:.4f},{:.4f}".format(
                info.width, info.height, info.resolution,
                info.origin.position.x, info.origin.position.y).encode())
            h.update(np.asarray(grid.data, dtype=np.int8).tobytes())
            return h.hexdigest()
        except Exception:
            return None

    def _zones_behind_rules(self):
        """Zones whose paths were not generated under the rules that bear on them
        now. A rule far from a zone, or a new seq with the same set, is no change."""
        zones = list(self.map_data.zones) if self.map_data is not None else []
        return [z for z in zones
                if (getattr(z, 'rules_fp', '')
                    != coverage_rules.fingerprint(self._zone_rules(z.msg)))]

    def callback_map_rules(self, msg):
        """Latched /map_objects/rules. Only a change that moves a path reaches the
        refresh worker, through the same debounce as an edited map."""
        try:
            self._map_rules = coverage_rules.parse_rules(msg.data)
        except (ValueError, TypeError, IndexError, AttributeError) as e:
            rospy.logwarn("[{}] /map_objects/rules ignored: {}".format(
                rospy.get_caller_id(), e))
            return
        self._check_rules_behind()

    def _check_rules_behind(self):
        if not self._site_native() or not self._zones_behind_rules():
            return
        with self._site_map_lock:
            self._site_map_rules_dirty = True
        self._arm_site_map_timer()

    def callback_site_map(self, grid):
        """Persistent latched subscriber on /mapping_manager/site_map. On a NEW
        grid (fingerprint differs from the last seen): stash it and (re)arm a
        2.5 s debounce timer. Flag off -> no-op. Never blocks: the actual
        rebuild+zone-regen runs in a worker thread (see _site_map_worker)."""
        if not self._site_native():
            return
        fp = self._grid_fingerprint(grid)
        with self._site_map_lock:
            if fp is not None and fp == self._site_map_last_fp:
                return  # identical grid re-latched -> nothing to do
            self._site_map_last_fp = fp
            self._site_map_pending = grid
        self._arm_site_map_timer()

    def _arm_site_map_timer(self):
        # (re)arm the debounce timer outside the lock; edits arrive in bursts, so
        # each new grid pushes the fire time out another 2.5 s.
        if self._site_map_timer is not None:
            try:
                self._site_map_timer.shutdown()
            except Exception:
                pass
        self._site_map_timer = rospy.Timer(rospy.Duration(2.5),
                                           self._site_map_timer_fire,
                                           oneshot=True)

    def _site_map_timer_fire(self, event):
        """Debounce elapsed. Start the worker if idle; if a run is already in
        progress, flag a rerun so the just-arrived grid is picked up after it."""
        with self._site_map_lock:
            if self._site_map_worker_active:
                self._site_map_rerun = True
                return
            self._site_map_worker_active = True
        t = threading.Thread(target=self._site_map_worker,
                             name="site_map_refresh")
        t.daemon = True
        t.start()

    def _site_map_worker(self):
        """Worker loop: process the pending grid, then loop once more if a new
        grid arrived (rerun flag) so bursts coalesce into at most one trailing
        run. Guarded so only one worker runs at a time."""
        try:
            while True:
                with self._site_map_lock:
                    grid = self._site_map_pending
                    self._site_map_pending = None
                    rules = self._site_map_rules_dirty
                    self._site_map_rules_dirty = False
                if grid is not None or rules:
                    self._do_live_refresh(grid)
                with self._site_map_lock:
                    if not self._site_map_rerun:
                        break
                    self._site_map_rerun = False
                    if self._site_map_pending is None and not self._site_map_rules_dirty:
                        break
        finally:
            with self._site_map_lock:
                self._site_map_worker_active = False

    def _do_live_refresh(self, grid):
        """Rebuild the workspace from `grid`, regenerate EVERY zone against the
        new free space, propagate the fresh zones into programs, export the
        bundle and republish the latched lists + map layers. grid None: the map is
        the same, the rules moved — only the zones behind them regenerate. On
        error the previous workspace is restored/kept. Runs in the worker thread.

        Never under a running mission: it mows its own copy, while the zones,
        the saved program and the markers would show paths it does not drive, and
        np_zone_navi would change under SMACH|ZONE. The map rules guard covers the
        mission; the refresh runs once it is over (_resume_deferred_refresh)."""
        if not self._site_native():
            return
        key = None if self._legacy_maps() else self._planner_key()
        if not self._legacy_maps() and not key:
            # Nothing served: the grid is mapping_manager's placeholder. Never
            # regenerate (and persist) a stale workspace's zones against it.
            return
        if (key and self._workspace_site != key
                and self.current_navi_map_name not in (None, "New")):
            # RETRY: the workspace of the served site is not complete (the
            # site_map was late at load time, zones / programs still pending).
            # A site_map just arrived -> run the full load path again.
            rospy.loginfo("[{}] site_map arrived — retrying the planner-data load "
                          "for site '{}'.".format(rospy.get_caller_id(), key))
            self.callback_load_planner_data(Bool(True))
            return
        if (not self.data_loaded or self.map_data is None
                or self.current_navi_map_name in (None, "New")):
            # No workspace to refresh yet (boot / new map). The load-time path
            # will rebuild once data is loaded.
            return
        # The site_map of a NEWLY served site can get here before its status
        # message: refreshing now would regenerate the old site's zones against
        # the new site's raster and persist that (pickle + bundle). Ask
        # mapping_manager (latched, 1 Hz) which site the grid belongs to.
        served_now = self._served_site_now()
        t0 = time.time()
        with self._workspace_lock:   # AUDIT #10
            if key and (served_now != self._workspace_site
                        or self._planner_key() != self._workspace_site):
                rospy.loginfo("[{}] site_map refresh skipped: mapping_manager serves "
                              "{!r}, the workspace belongs to {!r} (the load for the "
                              "served site does the work).".format(
                                  rospy.get_caller_id(), served_now, self._workspace_site))
                return
            if self._mission_running():
                self._defer_refresh(grid)
                return
            self._do_site_map_refresh_locked(grid, t0)

    def _mission_running(self):
        return self._program_is_running(self._mission_program) or self._mission_busy is True

    def _defer_refresh(self, grid):
        """Keep the work for the end of the mission. A newer grid that came in
        meanwhile wins; a full refresh also brings the rules up to date."""
        with self._site_map_lock:
            if grid is None:
                self._site_map_rules_dirty = True
            elif self._site_map_pending is None:
                self._site_map_pending = grid
            self._site_map_deferred = True
        rospy.loginfo("[{}] Planner refresh waits for the end of the running "
                      "mission.".format(rospy.get_caller_id()))

    def _resume_deferred_refresh(self):
        if not self._site_map_deferred or self._mission_running():
            return
        with self._site_map_lock:
            if not self._site_map_deferred:
                return
            self._site_map_deferred = False
        self._site_map_timer_fire(None)

    def _served_site_now(self):
        """serving.site from a fresh /mapping_manager/status, or None."""
        try:
            msg = rospy.wait_for_message('/mapping_manager/status', String, timeout=2.0)
            serving = json.loads(msg.data).get('serving') or {}
            return serving.get('site') if isinstance(serving, dict) else None
        except Exception as e:
            rospy.logwarn("[{}] No /mapping_manager/status ({}) — cannot tell which "
                          "site the site_map belongs to.".format(rospy.get_caller_id(), e))
            return None

    def _do_site_map_refresh_locked(self, grid, t0):
        prev_map_data = self.map_data
        try:
            # snapshot zone msgs before the raster swap; _regenerate_zone rebuilds
            # each from its polygon against the new assembled free space.
            zones = self._zones_behind_rules() if grid is None else self.map_data.zones
            prev_zone_msgs = [copy.deepcopy(z.msg) for z in zones]
            if grid is None:
                if not prev_zone_msgs:
                    return          # settled meanwhile
            elif not self._rebuild_workspace_from_grid(grid):
                # rebuild refused (empty/failed) -> keep previous workspace.
                self.map_data = prev_map_data
                return
            n = 0
            for zmsg in prev_zone_msgs:
                try:
                    zone = self._regenerate_zone(zmsg)
                    self._propagate_zone_to_programs(zone.msg)
                    n += 1
                except Exception as e:
                    rospy.logwarn("[{}] site_native live refresh: zone '{}' regen "
                                  "failed: {}".format(rospy.get_caller_id(),
                                                      getattr(zmsg, 'name', '?'), e))
                    self._drop_paths_behind_rules(zmsg)
            self.current_zone = None
            self.save_running_data()
            # export bundle (existing hooks) + republish latched UI lists/layers.
            self._bundle_export_zones()
            self._bundle_export_programs()
            self.map_zone_list_publisher()
            self.program_list_publisher()
            self.map_data_publisher()
            self.map_poly_list_publisher()
            rospy.loginfo("[{}] planner refreshed from site_map: {} zones "
                          "regenerated in {:.1f}s".format(
                              rospy.get_caller_id(), n, time.time() - t0))
        except Exception as e:
            self.map_data = prev_map_data
            rospy.logwarn("[{}] site_native live refresh failed ({}) — keeping "
                          "previous workspace.".format(rospy.get_caller_id(), e))

    def _drop_paths_behind_rules(self, zmsg):
        """A zone that failed to regenerate keeps its old paths, unless a rule
        bears on it: those may run through the rule. No paths = the program says
        so at start, instead of mowing there."""
        if not self._zone_rules(zmsg):
            return
        for zone in self.map_data.zones:
            if zone.msg.name == zmsg.name:
                zone.msg.paths = []
                self._propagate_zone_to_programs(zone.msg)

    def _programs_refuse_edit(self, what):
        """Program edits are refused while the list in memory is not the served
        site's list (swap pending) — the edit would land in the wrong site."""
        if self._programs_usable():
            return False
        text = ("{}: the programs of the active map are not loaded yet — try again "
                "in a moment.".format(what))
        self.log_publisher(text)
        rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))
        self.program_list_publisher()
        return True

    # ---- the mission's view of programs ------------------------------------
    # Mission states that do not move the robot any more: the program there is
    # over (Stopped / TERMINAL ERROR wait for Reset) or none runs.
    _MISSION_IDLE = ('', 'ready', 'stopped', 'terminal error', 'starting...')

    def callback_mission_program(self, msg):
        self._mission_program = (msg.data or '').strip()
        self._program_markers_sync()

    def callback_mission_status(self, msg):
        self._mission_status = (msg.data or '').strip()
        if self._mission_status in run_path.STARTING_STATUS:
            self._run_path_fresh = self._mission_status == run_path.FRESH_STATUS
        self._program_markers_sync()
        self._resume_deferred_refresh()

    def callback_run_path_busy(self, msg):
        self._run_path_busy = msg.data
        self._program_markers_sync()

    def callback_mission_busy(self, msg):
        self._mission_busy = bool(msg.data)
        self._resume_deferred_refresh()

    def callback_mission_stop(self, msg):
        if msg.data:
            self._map_gate.cancel()

    def callback_dock_status(self, msg):
        self._dock_status = msg.data

    def callback_in_dock(self, msg):
        self._in_dock = bool(msg.data)

    def callback_navi_ready(self, msg):
        try:
            self._navi_ready = json.loads(msg.data)
        except ValueError:
            pass

    def _program_is_running(self, name):
        if not name or name != self._mission_program:
            return False
        status = self._mission_status.lower()
        return not (status in self._MISSION_IDLE or status.startswith('rejected'))

    def _from_mission(self, msg):
        """A /web_plan/program_new sent by the mower mission itself: its
        periodic (60 s) and end-of-run write-back of last_result."""
        hdr = getattr(msg, '_connection_header', None) or {}
        return hdr.get('callerid') == self._mission_node

    def _mission_write_back(self, msg):
        """The mission reports how ITS run went; it never owns the program.

        Only last_result (the resume checkpoint) and last_duration_minutes are
        taken. The mission keeps the copy it started with and repeats it every
        60 s even after the run, so taking the whole message reverted every
        later edit (RPM, height, speed, zones) and brought a deleted or renamed
        program back within a minute."""
        for prg in self.permanent_program_list_msg.program_list:
            if prg.name == msg.name:
                if (prg.last_result == msg.last_result
                        and prg.last_duration_minutes == msg.last_duration_minutes):
                    return
                prg.last_result = msg.last_result
                prg.last_duration_minutes = msg.last_duration_minutes
                self.save_programs()
                self.program_list_publisher()
                self._bundle_export_programs()
                return
        rospy.loginfo("[{}] Mission result for program '{}' ignored: the program "
                      "is not in the list (removed or renamed).".format(
                          rospy.get_caller_id(), msg.name))

    def callback_program_new(self, msg):
        if self._from_mission(msg):
            # Silently dropped while the served site's list is not loaded: the
            # mission repeats it every 60 s and the next one lands.
            if self._programs_usable():
                self._mission_write_back(msg)
            return
        if self._programs_refuse_edit("Program '{}' NOT saved".format(msg.name)):
            return
        if msg.override_zone and not coverage_rules.cut_height_ok(msg.cut_height):
            text = "Program '{}' NOT saved: cut height {} mm is outside {}.".format(
                msg.name, msg.cut_height, coverage_rules.cut_height_text())
            self.log_publisher(text)
            rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))
            self.program_list_publisher()
            return
        if not self._legacy_maps() and not self._legacy_tagged(msg):
            # A program belongs to the map it is created on (vitulus-field#46):
            # a NEW one needs an active map; map_name names the owner site,
            # never the sender's value ('SITE' / 'New').
            served = self._planner_key()
            known = any(prg.name == msg.name
                        for prg in self.permanent_program_list_msg.program_list)
            if not served and not known:
                text = ("Program '{}' NOT saved: no map is active — activate a map "
                        "first (a program belongs to the map it is created "
                        "on).".format(msg.name))
                self.log_publisher(text)
                rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))
                self.program_list_publisher()
                return
            owner = served or self._programs_site
            if owner:
                msg.map_name = owner
        existing = any(prg.name == msg.name
                       for prg in self.permanent_program_list_msg.program_list)
        if not msg.zone_list and not existing:
            text = "Program '{}' NOT saved: it has no zones.".format(msg.name)
            self.log_publisher(text)
            rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))
            self.program_list_publisher()
            return
        # Zones are referenced by name: store the CURRENT workspace zones, never
        # the sender's copy (the mission reports last_result with the snapshot it
        # started with, which must not overwrite zones regenerated meanwhile).
        with self._workspace_lock:
            ws = {z.msg.name: z.msg for z in (self.map_data.zones if self.map_data else [])}
            msg.zone_list = [copy.deepcopy(ws[z.name]) if z.name in ws else z
                             for z in msg.zone_list]
        msg.area = min(int(sum(z.area for z in msg.zone_list)), 32767)   # int16
        msg.length = min(int(sum(z.length for z in msg.zone_list)), 32767)
        prg_list = [prg for prg in self.permanent_program_list_msg.program_list if prg.name != msg.name]
        prg_list.append(msg)
        self.permanent_program_list_msg.program_list = prg_list
        # print(self.permanent_program_list_msg)
        self.save_programs()
        self.program_list_publisher()
        self._bundle_export_programs()

    def callback_program_remove(self, msg):
        if self._programs_refuse_edit("Program '{}' NOT removed".format(msg.data)):
            return
        if self._program_is_running(msg.data):
            text = ("Program '{}' NOT deleted: it is running — Stop it first.".format(msg.data))
            self.log_publisher(text)
            rospy.logwarn("[{}] {}".format(rospy.get_caller_id(), text))
            self.program_list_publisher()
            return
        rospy.loginfo("[{}] Removing program {} from list".format(rospy.get_caller_id(), msg.data))
        ## Remove program from list
        removed = False
        for program in self.permanent_program_list_msg.program_list:
            if program.name == msg.data:
                self.permanent_program_list_msg.program_list.remove(program)
                rospy.loginfo("[{}] Program {} removed from list".format(rospy.get_caller_id(), msg.data))
                removed = True
                break
        if not removed:
            self._program_not_found(msg.data)
            self.program_list_publisher()
            return
        self.save_programs()
        self.program_list_publisher()
        # allow_empty: REALLY removing the last program must reach the site
        # bundle too, or it would come back on the next site change.
        self._bundle_export_programs(allow_empty=True)


    def log_publisher(self, log_txt):
        msg = String()
        msg.data = log_txt
        self.log_pub.publish(msg)

    def callback_reload(self, msg):
        # Boot-order race guard: /web_plan/reload can fire before
        # callback_navi_active_map has ever set current_navi_map_name (still None).
        # callback_load_planner_data then does string concat on None ("..." + None)
        # -> TypeError crash at boot. Skip until the map name is known; navi_man
        # republishes active_map on its slow tick, so a later reload succeeds.
        if self.current_navi_map_name is None:
            rospy.logwarn("[{}] callback_reload: navi active map name not known "
                          "yet (None) — skipping reload.".format(rospy.get_caller_id()))
            return
        msg = Bool(True)
        self.callback_load_planner_data(msg)
        self.map_data_publisher()
        self.map_poly_list_publisher()
        self.map_zone_list_publisher()
        self.program_list_publisher()
        # self.program_marker_publisher()

    def callback_republish(self, msg):
        # Re-publish the current lists WITHOUT reloading the planner data from
        # disk (cheap). Used by the web UI to reliably re-fetch the one-shot
        # zone/polygon/program lists over rosbridge.
        if msg.data:
            self.map_data_publisher()   # not latched: margin / fill / shape
            self.map_poly_list_publisher()
            self.map_zone_list_publisher()
            self.program_list_publisher()


