    def _running_program_msg(self, name):
        """The listed program the mission runs; None while the list in memory is
        not the served site's (map change) - it is drawn once it is."""
        if not name or self.permanent_program_list_msg is None or not self._programs_usable():
            return None
        for program in self.permanent_program_list_msg.program_list:
            if program.name == name and self._on_current_map(program):
                return program
        return None

    def _program_markers_sync(self, force=False):
        """Publish the picture when it differs from the published one. Called on
        every mission / Show change and from the main loop: it is a function of
        the state, so a late list or a planner restart in mid-run ends the same.
        The checkpoint (last_result) comes in at least every 60 s with the
        mission's write-back; the state of a new Run still holds the last run's."""
        with self._marker_lock:
            shown = self._shown_paths
            if shown.set_run(run_path.running_program(
                    self._run_path_busy, self._mission_program, self._mission_status)):
                self._run_path_old_result = None
            program = self._running_program_msg(shown.run)
            result = None
            if program is not None:
                if self._run_path_fresh:
                    self._run_path_fresh = False
                    self._run_path_old_result = program.last_result
                if program.last_result != self._run_path_old_result:
                    result = program.last_result
            checkpoint = run_path.parse_checkpoint(result)
            draw_run = program is not None and not shown.run_hidden
            drawn = (shown.run, draw_run, checkpoint, shown.manual, shown.manual_waits)
            if drawn == self._run_path_drawn and not force:
                return
            self._run_path_drawn = drawn
            marker_array = self._deleteall_marker_array()
            done_m = total_m = 0.0
            if program is not None:
                markers, done_m, total_m = run_path.build_markers(
                    program, rospy.Time.now(), checkpoint)
                if draw_run:
                    marker_array.markers.extend(markers)
            marker_array.markers.extend(shown.manual_visible())
            self.marker_program_paths_pub.publish(marker_array)
            self.program_marker_state_pub.publish(String(shown.state_json(done_m, total_m)))

