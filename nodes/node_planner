class Node:

    def __init__(self):
        self.permanent_program_list_msg = PlannerProgramList()
        self.permanent_program_list_msg.header.stamp = rospy.Time.now()
        self.permanent_program_list_msg.header.frame_id = "map"
        # First boot on a fresh install: the state dirs do not exist yet. Create
        # them so every later save/copy works instead of failing silently.
        for d in (_RUNNING_DIR, _SAVES_DIR):
            try:
                os.makedirs(d, exist_ok=True)
            except Exception as e:
                rospy.logerr("[{}] Cannot create planner state dir {}: {}".format(
                    rospy.get_caller_id(), d, e))
        self.map_data = None
        self.current_navi_map_name = None
        self.np_show = None
        self.current_zone = None
        self.data_loaded = None
        self.program_active = None
        self.current_program_marker_array = None
        self.rtabmap_map_received = False

        # Site-bundle (WP-C) state. `~bundle_site` forces a site; otherwise the
        # site is auto-resolved from manifest.navi_map == active navi map name.
        self._bundle_site_override = rospy.get_param("~bundle_site", None) or None
        self._bundle_site_cache = None          # resolved site for _bundle_site_key
        self._bundle_site_key = None            # navi map the cache was resolved for
        self._bundle_off_logged = False         # loginfo-once when no site resolves
        # site-native mode (flag-gated, DEFAULT OFF). navi_man owns the flag in
        # navi_manager.yaml and does NOT push it to the param server, so read the
        # yaml directly (cached); a /navi_manager/site_native rosparam, if set,
        # overrides (lets an operator flip live). See _site_native().
        self._site_native_cached = None
        # legacy-maps retirement (delegacy 2026-07-19). Mirrors navi_man's
        # legacy_maps gate (read from the SAME navi_manager.yaml; a
        # /navi_manager/legacy_maps rosparam overrides). When False, navi_man
        # publishes active_map='SITE' (constant) and the planner data / bundle
        # site are keyed on the SERVING mapping-v3 site instead of active_map.
        self._legacy_maps_cached = None
        # Currently served mapping-v3 site (name) from /mapping_manager/status.
        # None until a site is served. Drives planner_data key + bundle site in
        # site-native mode; a change triggers a planner-data reload for that site.
        self._served_site = None
        # Site the in-memory raster (map_data) was built for. A load for a
        # DIFFERENT site must not carry the old site's zones over.
        self._raster_site = None
        # Site whose workspace is COMPLETE: raster built AND zones in sync with
        # the site bundle. Until then every load retries the full (forced) path.
        self._workspace_site = None
        # Site the in-memory program list belongs to (site-native mode). The
        # program pickle is global, so ownership is persisted in a sidecar file
        # and the list is swapped when another site gets served (see
        # _swap_programs). None = unknown (first boot / legacy data).
        # _programs_untrusted: a swap was interrupted (crash) — the pickle may
        # hold either site's list, so it is rebuilt from the bundle, not adopted.
        self._programs_site, self._programs_untrusted = self._programs_site_read()
        # The pickle could not be loaded (missing / corrupt): the list in memory
        # is NOT authoritative — import it from the served site's programs.yaml
        # and never export it before that happened.
        self._programs_need_import = False
        self._programs_pkl_good = False
        # (site, text) while the served site's programs could not be loaded.
        self._programs_pending = None
        self._programs_pending_told = set()

        # site_native live-refresh (WP-editsync 2026-07-18): keep a PERSISTENT
        # latched subscriber to /mapping_manager/site_map so operator map edits
        # (obstacle/free/wall composited by mapping_manager) rebuild the planner
        # workspace AND regenerate every zone live — no map reload needed. State
        # for debounce + single-worker coalescing (see callback_site_map). All
        # gated on _site_native(); when the flag is off the callback is a no-op.
        self._site_map_lock = threading.Lock()
        self._site_map_last_fp = None       # fingerprint of last grid SEEN (dedup)
        self._site_map_pending = None       # newest grid awaiting a refresh run
        self._site_map_timer = None         # debounce oneshot rospy.Timer
        self._site_map_worker_active = False
        # AUDIT #10 (2026-08-01): serialize the site_map refresh worker vs
        # zone-mutating callbacks (save/remove) — both touch map_data.zones.
        # Reentrant: the planner-data load takes it too (it regenerates zones on a
        # bundle import) and is itself called from paths that may hold it.
        self._workspace_lock = threading.RLock()
        self._site_map_rerun = False        # a grid arrived mid-run -> run again

        # ---- publishers FIRST: subscriber callbacks can fire as soon as a
        # subscriber exists (latched active_map / status / site_map), and they
        # publish lists + log lines — so every publisher must already exist.
        self.log_pub = rospy.Publisher("/web_plan/log", String, queue_size=1)
        self.map_show_pub = rospy.Publisher("/web_plan/map_show", OccupancyGrid, queue_size=1)
        self.map_data_pub = rospy.Publisher("/web_plan/map_data", MapEditMap, queue_size=1)
        self.map_poly_list_pub = rospy.Publisher("/web_plan/polygon_list", MapEditPolygonList, latch=True, queue_size=1)
        self.zone_list_pub = rospy.Publisher("/web_plan/zone_list", MapEditZoneList, latch=True, queue_size=1)
        # Machine-readable outcome of every zone save/remove request (JSON in a
        # String: {"op", "name", "ok", "message"}), so the UI can confirm a save
        # instead of closing the form blindly. NOT latched (a stale result must
        # never answer a new request).
        self.zone_result_pub = rospy.Publisher("/web_plan/zone_result", String, queue_size=10)
        # Mowing-path preview of the SELECTED / just saved zone (frame 'map').
        # Latched; every message starts with a DELETEALL marker, so a client just
        # feeds it to a MarkerArray client. Cleared on cancel/remove/site change.
        self.zone_preview_pub = rospy.Publisher("/web_plan/zone_preview_marker", MarkerArray, latch=True, queue_size=1)
        self.marker_program_paths_pub = rospy.Publisher("/web_plan/program_marker", MarkerArray, queue_size=0)
        self.map_edited_pub = rospy.Publisher("/web_plan/map_edited", OccupancyGrid, queue_size=1)
        self.program_list_pub = rospy.Publisher("/web_plan/program_list", PlannerProgramList, latch=True, queue_size=10)
        self.program_active_pub = rospy.Publisher("/web_plan/program_active", PlannerProgram, queue_size=1)
        self.program_active_unfinished_pub = rospy.Publisher("/web_plan/program_active_unfinished", PlannerProgram, queue_size=1)
        self.planner_loaded_pub = rospy.Publisher("/web_plan/planner_loaded", String, queue_size=1, latch=True)

        # Needs log_pub + program_list_pub (publishes the loaded list, latched).
        # On a load failure / fresh install still latch the (empty) list so late
        # subscribers (master_controller, web UI) reliably get one.
        if not self.load_programs():
            self.program_list_publisher()
        self.clean_running_dir()

        # ---- subscribers / services
        self.site_map_sub = rospy.Subscriber("/mapping_manager/site_map",
                                             OccupancyGrid, self.callback_site_map,
                                             queue_size=1)

        self.reload_sub = rospy.Subscriber("/web_plan/reload", Bool, self.callback_reload)
        self.map_sub = rospy.Subscriber("/rtabmap/grid_map", OccupancyGrid, self.callback_map)
        self.map_assemble_sub = rospy.Subscriber("/web_plan/assemble_map", MapEditMap, self.callback_map_assemble)
        self.map_show_map_layer_sub = rospy.Subscriber("/web_plan/show_map_layer", String, self.callback_show_map_layer)
        self.map_save_poly_sub = rospy.Subscriber("/web_plan/save_polygon", MapEditPolygon, self.callback_map_save_poly)
        self.map_remove_poly_sub = rospy.Subscriber("/web_plan/remove_polygon", String, self.callback_map_remove_poly)
        self.zone_save_sub = rospy.Subscriber("/web_plan/save_zone", MapEditZone, self.callback_map_save_zone)
        self.zone_remove_sub = rospy.Subscriber("/web_plan/remove_zone", String, self.callback_zone_remove)
        self.zone_selected_sub = rospy.Subscriber("/web_plan/selected_zone", String, self.callback_zone_selected)
        self.navi_active_map_sub = rospy.Subscriber("/navi_manager/active_map", String, self.callback_navi_active_map)
        # Currently served mapping-v3 site (delegacy 2026-07-19). In site-native
        # mode (legacy_maps=False) active_map is the constant 'SITE', so the
        # serving-site change — not active_map — drives planner-data reloads.
        self.mapping_status_sub = rospy.Subscriber("/mapping_manager/status", String, self.callback_mapping_status)
        self.load_planner_data_sub = rospy.Subscriber("/web_plan/load_planner_data", Bool, self.callback_load_planner_data)
        self.save_planner_data_sub = rospy.Subscriber("/web_plan/save_planner_data", Bool, self.callback_save_planner_data)
        self.reload_map_sub = rospy.Subscriber("/web_plan/reload_map", Bool, self.callback_reload_map)
        # Lightweight "re-publish the current lists" trigger (no pickle reload) —
        # lets the web UI reliably re-fetch zone/polygon/program lists (which are
        # one-shot over rosbridge) without the heavy reload of /web_plan/reload.
        self.republish_sub = rospy.Subscriber("/web_plan/republish", Bool, self.callback_republish)
        # self.new_map_sub = rospy.Subscriber("/web_plan/new_map", String, self.callback_new_map)

        self.program_select_sub = rospy.Subscriber("/web_plan/program_select", String, self.callback_program_select)
        self.program_select_resume_sub = rospy.Subscriber("/web_plan/program_select_resume", String, self.callback_program_select_resume)
        self.program_new_sub = rospy.Subscriber("/web_plan/program_new", PlannerProgram, self.callback_program_new)
        self.program_remove_sub = rospy.Subscriber("/web_plan/program_remove", String, self.callback_program_remove)
        self.program_to_show_marker_sub = rospy.Subscriber("/web_plan/program_to_show_marker", PlannerProgram, self.callback_program_to_show_marker)

        self.save_map_srv = rospy.Service("/web_plan/save_map", Save_map, self.save_map)

    def save_map(self, srv):
        if srv.name != "":
            self.current_navi_map_name = srv.name + "***env*" + srv.environment
            # self.callback_reload_map(Bool(True))
            self.map_sub.unregister()
            self.map_sub = rospy.Subscriber("/rtabmap/grid_map", OccupancyGrid, self.callback_map)
            self.data_loaded = False
            self.rtabmap_map_received = False
            while not self.rtabmap_map_received:
                rospy.sleep(0.5)
                rospy.loginfo("[{}] Planner wait for rtabmap.".format(rospy.get_caller_id()))
            rospy.loginfo("[{}] Planner rtabmap map received.".format(rospy.get_caller_id()))
            # self.callback_save_planner_data(Bool(True))
            if self.save_running_data() and exists(_RUNNING_PKL):
                shutil.copyfile(_RUNNING_PKL,
                                _saves_pkl(self.current_navi_map_name))
                self.log_publisher("Planner data saved.")
                rospy.loginfo("[{}] Planner data saved.".format(rospy.get_caller_id()))
                # Mirror zones + programs into the site bundle on map save.
                self._bundle_export_zones()
                self._bundle_export_programs()

            self.log_publisher("Planner map saved.")
            rospy.loginfo("[{}] Planner map saved.".format(rospy.get_caller_id()))
            return Save_mapResponse("OK", "Map " + self.current_navi_map_name + "saved.")
        else:
            self.log_publisher("Map name is empty.")
            rospy.logwarn("[{}] Map name is empty.".format(rospy.get_caller_id()))
            return Save_mapResponse("FAILED", "Map name is empty.")

    def clean_running_dir(self):
        if (exists(_RUNNING_PKL)):
            os.remove(_RUNNING_PKL)
            self.log_publisher("Running planner data cleaned.")
            rospy.loginfo("[{}] Running planner data cleaned.".format(rospy.get_caller_id()))

    def callback_reload_map(self, msg):
        if msg.data:
            self.map_sub.unregister()
            self.map_sub = rospy.Subscriber("/rtabmap/grid_map", OccupancyGrid, self.callback_map)
            self.data_loaded = False
            self.log_publisher("Be shure that you have loaded the map with RtabMap.")
            self.log_publisher("Reloading map from /rtabmap/grid_map")
            rospy.loginfo("[{}] Reloading map from /rtabmap/grid_map".format(rospy.get_caller_id()))

    def callback_load_planner_data(self, msg):
        if not msg.data:
            return
        # Serialised with every other workspace mutation (zone save/remove, the
        # live site_map refresh): a bundle import regenerates zones through the
        # shared self.current_zone / self.map_data.
        with self._workspace_lock:
            self._load_planner_data_locked()

    def _load_planner_data_locked(self):
        if not self._legacy_maps():
            # ---- site-native (delegacy 2026-07-19): keyed on the SERVED site ----
            key = self._planner_key()            # served site name, or None
            if not key:
                self.log_publisher("No site served yet — planner data unavailable.")
                rospy.logwarn("[{}] Planner: no site served — cannot load planner "
                              "data yet (waits for /mapping_manager/status "
                              "serving.site).".format(rospy.get_caller_id()))
                return
            # Workspace of this site not complete yet (another site was loaded,
            # first load after boot, or an earlier attempt failed): full path.
            site_changed = (key != self._workspace_site)
            pkl_loaded = False
            if site_changed:
                # The saved pickle seeds the workspace ONLY on a site change; on a
                # plain reload the memory state is the truth (the pickle is kept
                # in sync by save_running_data, never newer).
                pkl = _saves_pkl(key)
                if self._raster_site != key and exists(pkl):
                    shutil.copyfile(pkl, _RUNNING_PKL)
                    pkl_loaded = self.load_running_data(" (site '{}')".format(key))
                if pkl_loaded:
                    self._raster_site = key
                    self.current_zone = None
                elif self._raster_site != key:
                    # No (valid) saved planner_data for this site yet — build a
                    # fresh workspace from the served raster below.
                    rospy.loginfo("[{}] Planner: no saved planner_data for served site "
                                  "'{}' — building fresh from the served raster.".format(
                                      rospy.get_caller_id(), key))
            # site_native (2): (re)build the zone-generation workspace raster from
            # the served site_map. This CREATES map_data even when there was no
            # pickle, so zone regen / bundle import run against the site free space.
            # The in-memory zones are carried over ONLY when they belong to this
            # site — never leak the previous site's zones (they would even get
            # exported into this site's bundle).
            if self._rebuild_map_from_site_grid(carry=(self._raster_site == key)):
                self._raster_site = key
            elif self._raster_site != key:
                # Nothing could be built for the new site: drop the previous
                # site's workspace rather than keep serving its zones.
                self.map_data = None
                self.current_zone = None
                self._raster_site = None
            self.data_loaded = self.map_data is not None
            # Bundle-wins: rebuild zones/programs from the site bundle when newer.
            # FORCED for a newly served site WITHOUT a saved pickle: nothing in
            # memory reflects this site's bundle yet (the import stamp only says
            # "seen before"). With a pickle the stamp/mtime test decides (A4).
            zones_ok = self._bundle_import_if_newer(
                force=(site_changed and not pkl_loaded))
            if self._raster_site == key and zones_ok:
                if site_changed:
                    self.save_running_data()   # seed saves/<site>.pkl (A4)
                self._workspace_site = key
            else:
                self._workspace_site = None
                rospy.logwarn("[{}] Planner workspace for site '{}' is NOT complete "
                              "(raster: {}, zones: {}) — retried on the next site_map "
                              "/ reload.".format(rospy.get_caller_id(), key,
                                                 self._raster_site == key, zones_ok))
            if site_changed:
                self._clear_zone_preview()
                self.map_zone_list_publisher()
                self.map_poly_list_publisher()
                self.program_list_publisher()
            self.planner_loaded_pub.publish(String(key))
            return
        # ---- legacy path (legacy_maps=True): keyed on active navi map name ----
        if self.current_navi_map_name != "New":
            if (exists(_saves_pkl(self.current_navi_map_name))):
                shutil.copyfile(_saves_pkl(self.current_navi_map_name),
                                _RUNNING_PKL)
                self.data_loaded = self.load_running_data()
                if not self.data_loaded:
                    self.log_publisher("Planner data NOT loaded (saved data unusable).")
                # site_native (2): rebuild the zone-generation workspace raster
                # from the served site raster BEFORE the bundle zone/program
                # import, so any zone regen runs against the site free space.
                if self.data_loaded:
                    self._rebuild_map_from_site_grid()
                # Bundle-wins: if the site bundle is newer than the just-loaded
                # pickles, rebuild zones/programs from it (UTM -> map, regen).
                self._bundle_import_if_newer()
                self.planner_loaded_pub.publish(String(self.current_navi_map_name))
        else:
            self.log_publisher("Not loaded!!! It's a new map. Save it in Navi Manager first.")
            rospy.logwarn("[{}] Not loaded!!! It's a new map.".format(rospy.get_caller_id()))

    def callback_save_planner_data(self, msg):
        if not msg.data:
            return
        # Pickle key: served site in site-native, active navi map name in legacy.
        key = self._planner_key()
        if not key or key == "New":
            self.log_publisher("Not saved!!! No site served / new map. Save it in "
                               "Navi Manager first.")
            rospy.logwarn("[{}] Planner data not saved (no served site / new "
                          "map).".format(rospy.get_caller_id()))
            return
        if not self.save_running_data():
            self.log_publisher("Not saved!!! No planner workspace (no map is active).")
            rospy.logwarn("[{}] Planner data not saved (no workspace / write "
                          "failed).".format(rospy.get_caller_id()))
            return
        if (exists(_RUNNING_PKL)):
            shutil.copyfile(_RUNNING_PKL,
                            _saves_pkl(key))
            self.log_publisher("Planner data saved.")
            rospy.loginfo("[{}] Planner data saved (key '{}').".format(
                rospy.get_caller_id(), key))
            # Mirror zones + programs into the site bundle on explicit save.
            self._bundle_export_zones()
            self._bundle_export_programs()

    def callback_navi_active_map(self, msg):
        if self.current_navi_map_name is not None:
            if msg.data != self.current_navi_map_name:
                self.current_navi_map_name = msg.data
                print("Map changed to: {}".format(self.current_navi_map_name))
                self._clear_markers_for_map_change()
                self.callback_load_planner_data(Bool(True))
                ## Do something if map is changed
        else:
            self.current_navi_map_name = msg.data
            print("Map changed to: {}".format(self.current_navi_map_name))
            self.callback_load_planner_data(Bool(True))
            ## Do something if initiated

    # Callback of RtabMap grid_map for initiate planner map
    def callback_map(self, msg):
        print("callback_map")
        if self.data_loaded is not None:
            if not self.data_loaded:
                rospy.loginfo("[{}] Map received".format(rospy.get_caller_id()))
                arr = np.array(msg.data, dtype=np.int8)
                arr = arr.reshape((msg.info.height, msg.info.width))
                self.map_data = MapData(np_map=arr, map_msg=msg)
                if self.map_data.planner_program_list_msg is None:
                    self.map_data.planner_program_list_msg = PlannerProgramList()
                    self.map_data.planner_program_list_msg.header.frame_id = "map"
                    self.map_data.planner_program_list_msg.header.stamp = rospy.Time.now()
                    self.map_data.planner_program_list_msg.program_list = []

                self.np_show = self.map_data.np_unk
                self.map_data_publisher()
                self.map_poly_list_publisher()
                self.assemble_map()
                self.map_sub.unregister()
                self.rtabmap_map_received = True

    def map_show_publisher(self):
        if self.map_data is not None and self.np_show is not None:
            map_msg = OccupancyGrid()
            map_msg.header.stamp = rospy.Time.now()
            map_msg.header.frame_id = "map"
            map_msg.info = self.map_data.initial_map.info
            map_msg.info.width = self.np_show.shape[1]
            map_msg.info.height = self.np_show.shape[0]
            np_arr = self.np_show.reshape((self.np_show.size,))
            map_msg.data = np_arr.tolist()
            self.map_show_pub.publish(map_msg)

    def map_edited_publisher(self):
        if self.map_data is not None and self.np_show is not None:
            if (self.current_navi_map_name != "New"):
                map_msg = OccupancyGrid()
                map_msg.header.stamp = rospy.Time.now()
                map_msg.header.frame_id = "map"
                map_msg.info = self.map_data.initial_map.info
                map_msg.info.width = self.map_data.np_assembled.shape[1]
                map_msg.info.height = self.map_data.np_assembled.shape[0]
                np_arr = self.np_show.reshape((self.np_show.size,))
                map_msg.data = np_arr.tolist()
                self.map_edited_pub.publish(map_msg)
            else:
                map_msg = OccupancyGrid()
                map_msg.info.resolution = 0.05
                map_msg.info.origin.orientation.w = 1
                self.map_edited_pub.publish(map_msg)
        else:
            map_msg = OccupancyGrid()
            map_msg.info.resolution = 0.05
            map_msg.info.origin.orientation.w = 1
            self.map_edited_pub.publish(map_msg)



    def assemble_map(self):
        self.map_data.clear_layers()
        self.draw_map_polygons()
        # Create basic map layers (unk, free, occupied)
        self.map_data.np_unk = np.where(self.map_data.np_original == MapSpec.UNKNOWN, MapSpec.OBSTACLE, self.map_data.np_unk)
        self.map_data.np_occupied = np.where(self.map_data.np_original == MapSpec.OBSTACLE, MapSpec.OBSTACLE, self.map_data.np_occupied)
        self.map_data.np_free = np.where(self.map_data.np_original == MapSpec.FREE, MapSpec.FREE, self.map_data.np_free)

        # Remove unknown noise
        shape_size = self.map_data.fill_hole_px
        kernel = cv2.getStructuringElement(self.map_data.fill_shape_cv,
                                           (2 * shape_size + 1, 2 * shape_size + 1),
                                           (shape_size, shape_size))
        self.map_data.np_unk_cleaned = cv2.dilate(self.map_data.np_unk.view(np.uint8), kernel, iterations=1)
        shape_size = self.map_data.fill_hole_px + 2
        kernel = cv2.getStructuringElement(self.map_data.fill_shape_cv,
                                           (2 * shape_size + 1, 2 * shape_size + 1),
                                           (shape_size, shape_size))
        self.map_data.np_unk_cleaned = cv2.erode(self.map_data.np_unk_cleaned, kernel, iterations=1)
        self.map_data.np_unk_cleaned = self.map_data.np_unk_cleaned.view(np.int8)


        # Unknown as obstacle
        self.map_data.np_occupied = np.where(self.map_data.np_unk_cleaned == MapSpec.OBSTACLE, self.map_data.np_unk_cleaned, self.map_data.np_occupied)

        # Fill holes in free
        shape_size = self.map_data.fill_hole_px
        kernel = cv2.getStructuringElement(self.map_data.fill_shape_cv,
                                           (2 * shape_size + 1, 2 * shape_size + 1),
                                           (shape_size, shape_size))
        self.map_data.np_free_filled = cv2.erode(self.map_data.np_free.view(np.uint8), kernel, iterations=1)
        self.map_data.np_free_filled = self.map_data.np_free_filled.view(np.int8)

        # Semi assembled map
        self.map_data.np_semi_assembled = np.where(self.map_data.np_free_filled == MapSpec.FREE, MapSpec.FREE, self.map_data.np_semi_assembled)
        self.map_data.np_semi_assembled = np.where(self.map_data.np_occupied == MapSpec.OBSTACLE, MapSpec.OBSTACLE, self.map_data.np_semi_assembled)
        self.map_data.np_semi_assembled = np.where(self.map_data.np_poly_free == MapSpec.FREE, MapSpec.FREE, self.map_data.np_semi_assembled)
        self.map_data.np_semi_assembled = np.where(self.map_data.np_poly_obstacle == MapSpec.OBSTACLE, MapSpec.OBSTACLE, self.map_data.np_semi_assembled)

        # Obstacle margin
        shape_size = self.map_data.obstacle_margin_px
        kernel = cv2.getStructuringElement(self.map_data.fill_shape_cv,
                                           (2 * shape_size + 1, 2 * shape_size + 1),
                                           (shape_size, shape_size))
        self.map_data.np_obstacle_margin = cv2.dilate(self.map_data.np_semi_assembled.view(np.uint8), kernel, iterations=1)
        self.map_data.np_obstacle_margin = self.map_data.np_obstacle_margin.view(np.int8)

        # Assemble map
        self.map_data.np_assembled = np.where(self.map_data.np_obstacle_margin == MapSpec.OBSTACLE, MapSpec.OBSTACLE, self.map_data.np_semi_assembled)

        # Show map
        self.np_show = self.map_data.np_assembled
        self.log_publisher("Map Assembled.")
        rospy.loginfo("[{}] Map assembled.".format(rospy.get_caller_id()))

    def callback_map_assemble(self, msg):
        if not self._ensure_workspace("Map NOT assembled"):
            return
        self.map_data.obstacle_margin = msg.margin
        self.map_data.obstacle_margin_px = int(round(msg.margin / self.map_data.resolution))
        self.map_data.fill_hole_px = msg.fill
        self.map_data.fill_shape = msg.shape
        if msg.shape == 'ellipse':
            self.map_data.fill_shape_cv = cv2.MORPH_ELLIPSE
        if msg.shape == 'square':
            self.map_data.fill_shape_cv = cv2.MORPH_RECT
        self.assemble_map()
        self.map_data_publisher()
        self.map_zone_list_publisher()
        self.program_list_publisher()
        self.save_running_data()

