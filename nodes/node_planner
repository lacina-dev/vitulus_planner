    def _regenerate_zone(self, msg):
        """Build a Zone (mask layers + outline/coverage paths) from a
        MapEditZone msg and store it in map_data.zones (add or replace by
        name). Sets self.current_zone. Returns the Zone.

        This is the geometry-generation core shared by the live save_zone
        handler and the site-bundle import path — regeneration MUST go through
        this single code path so imported zones get identical coverage.
        """
        polygon = []
        for point in msg.polygon.polygon.points:
            x_point = int(point.x / self.map_data.resolution)
            y_point = int(point.y / self.map_data.resolution)
            polygon.append([self.map_data.x_origin + x_point, self.map_data.y_origin + y_point])
        np_polygon = np.array(polygon)

        # make zone polygon smaller by cut coverage radius
        shape_poly = geometry.Polygon(np_polygon)
        cut_margin_dist = int(round((MapSpec.COVERAGE_DIAMETER / 2) / self.map_data.resolution))
        shape_poly = shape_poly.buffer(-cut_margin_dist)
        pointarray = []
        for point in shape_poly.exterior.coords:
            pointarray.append([int(point[0]), int(point[1])])
        np_polygon_mow = np.array(pointarray)

        # draw polygon on zone layer
        np_zone = np.zeros_like(self.map_data.np_assembled)
        cv2.fillPoly(np_zone, pts=[np_polygon_mow], color=MapSpec.OBSTACLE)
        np_zone = np.where(np_zone == MapSpec.OBSTACLE, self.map_data.np_assembled, MapSpec.OBSTACLE)

        # make zone polygon bigger by obstacle margin and draw zone map for navi
        shape_poly = geometry.Polygon(np_polygon)
        shape_poly = shape_poly.buffer(self.map_data.obstacle_margin_px, cap_style='flat', join_style='mitre')
        pointarray = []
        for point in shape_poly.exterior.coords:
            pointarray.append([int(point[0]), int(point[1])])
        np_polygon_navi = np.array(pointarray)

        # draw polygon on navi zone layer
        np_zone_navi = np.zeros_like(self.map_data.np_assembled)
        cv2.fillPoly(np_zone_navi, pts=[np_polygon_navi], color=MapSpec.OBSTACLE)
        np_zone_navi = np.where(np_zone_navi == MapSpec.OBSTACLE, self.map_data.np_semi_assembled, MapSpec.OBSTACLE)
        zone = Zone(np_zone, np_zone_navi, msg)
        # Store first clicked point as start reference (ROS map frame, metres)
        if len(msg.polygon.polygon.points) > 0:
            zone.start_point = geometry.Point(msg.polygon.polygon.points[0].x,
                                              msg.polygon.polygon.points[0].y)

        # Create paths around zone and coverage paths
        self.current_zone = zone
        self.create_paths_around()
        self.current_zone.msg.paths = []
        self.current_zone.msg.length = 0
        self.create_outline_path_msg()
        self.create_coverage_paths()
        self.create_coverage_path_msg()
        self.current_zone.msg.length = int(round(self.current_zone.msg.length))
        # print("Zone path length: {}".format(self.current_zone.msg.length))

        # Save or update current zone
        zone_exist = False
        zone_exist_id = -1
        i = 0
        for z in self.map_data.zones:
            if z.msg.name == msg.name:
                zone_exist = True
                zone_exist_id = i
            i += 1
        if not zone_exist:
            self.map_data.zones.append(self.current_zone)
        else:
            self.map_data.zones[zone_exist_id] = self.current_zone
        return self.current_zone

    def _ensure_workspace(self, what, report=True):
        """True when a planner workspace (map_data) exists. When it does not but
        a site IS served (site-native), try to build it right now from the served
        raster (same path a site change takes) instead of failing. Otherwise
        report `what` + the reason to the UI log and return False — never throw
        inside a rospy callback (the request would be lost silently).
        report=False: the caller reports the failure itself."""
        if self.map_data is not None:
            return True
        if not self._legacy_maps() and self._planner_key():
            rospy.loginfo("[{}] No planner workspace yet — building it from the "
                          "served site '{}'.".format(rospy.get_caller_id(),
                                                     self._planner_key()))
            try:
                self.callback_load_planner_data(Bool(True))
            except Exception as e:
                rospy.logerr("[{}] Lazy workspace build failed: {}".format(
                    rospy.get_caller_id(), e))
            if self.map_data is not None:
                return True
        if report:
            text = "{}: no map is active — activate or record a map first.".format(what)
            self.log_publisher(text)
            rospy.logerr("[{}] {}".format(rospy.get_caller_id(), text))
        return False

    def _zone_result(self, op, name, ok, message):
        """Unambiguous outcome of a zone save/remove for the UI: a JSON String on
        /web_plan/zone_result {"op": "save"|"remove", "name", "ok", "message"}
        (published AFTER the latched zone_list update on success), plus the same
        text on /web_plan/log."""
        self.log_publisher(message)
        if not ok:
            rospy.logerr("[{}] {}".format(rospy.get_caller_id(), message))
        self.zone_result_pub.publish(String(json.dumps(
            {"op": op, "name": name, "ok": bool(ok), "message": message})))

    def callback_map_save_zone(self, msg):
        # /web_plan/zone_result contract: exactly ONE result for EVERY attempt,
        # on success published after the latched zone_list update.
        ok = False
        text = "Zone '{}' NOT saved: internal planner error.".format(msg.name)
        try:
            ok, text = self._save_zone(msg)
        except Exception as e:
            rospy.logerr("[{}] Zone '{}' save failed: {}".format(
                rospy.get_caller_id(), msg.name, e))
        finally:
            self._zone_result("save", msg.name, ok, text)

    def _save_zone(self, msg):
        """Returns (ok, message for the UI)."""
        if not self._ensure_workspace("Zone '{}' NOT saved".format(msg.name),
                                      report=False):
            return False, ("Zone '{}' NOT saved: no map is active — activate or "
                           "record a map first.".format(msg.name))
        # The whole save runs under the workspace lock and works on the zone
        # object returned by the regen — self.current_zone is shared with the
        # live-refresh worker and the zone selection.
        with self._workspace_lock:   # AUDIT #10
            try:
                zone = self._regenerate_zone(msg)
            except Exception as e:
                # e.g. a polygon too small / outside the map: the zone list is
                # untouched (the zone is stored only at the end of the regen).
                self.current_zone = None
                self._clear_zone_preview()
                rospy.logerr("[{}] Zone '{}' regeneration failed: {}".format(
                    rospy.get_caller_id(), msg.name, e))
                return False, ("Zone '{}' NOT saved: mowing paths could not be "
                               "generated — the zone is too small or lies outside "
                               "the map.".format(msg.name))
            self.map_zone_list_publisher()
            # Show zone map
            self.np_show = zone.np_zone_paths
            self._publish_zone_preview(zone)
            # Push the edited zone (new shape/route) into existing programs that use
            # it, so a map change is reflected without rebuilding the programs.
            self._propagate_zone_to_programs(zone.msg)
            self.program_list_publisher()
            self.save_running_data()
            # Mirror the workspace zones into the site bundle (UTM, bundle-wins).
            self._bundle_export_zones()
        return True, "Zone {} saved.".format(zone.msg.name)

    def callback_zone_remove(self, msg):
        ok = False
        text = "Zone '{}' NOT removed: internal planner error.".format(msg.data)
        try:
            ok, text = self._remove_zone(msg.data)
        except Exception as e:
            rospy.logerr("[{}] Zone '{}' remove failed: {}".format(
                rospy.get_caller_id(), msg.data, e))
        finally:
            self._zone_result("remove", msg.data, ok, text)

    def _remove_zone(self, name):
        """Returns (ok, message for the UI)."""
        if self.map_data is None:
            return False, "Zone '{}' NOT removed: no map is active.".format(name)
        with self._workspace_lock:   # AUDIT #10
            # Remove zone
            self.map_data.zones = [z for z in self.map_data.zones
                                   if z.msg.name != name]
            self.map_zone_list_publisher()
            if self.current_zone is not None and self.current_zone.msg.name == name:
                self.current_zone = None
            self._clear_zone_preview()
            # AUDIT A2 (2026-08-01): the merge export below preserves bundle-only
            # zones BY DESIGN, so a plain export would resurrect the deleted zone
            # on the next import. Delete it from the bundle file explicitly —
            # BEFORE the programs export, whose zone-name merge keeps names that
            # still exist in zones.geojson.
            self._bundle_remove_zone(name)
            # Drop the removed zone from existing programs that referenced it.
            self._remove_zone_from_programs(name)
            self.program_list_publisher()
            # Show map
            self.np_show = self.map_data.np_assembled
            self.save_running_data()
            # Reflect the removal in the site bundle.
            self._bundle_export_zones()
        return True, "Zone {} removed.".format(name)

    def callback_zone_selected(self, msg):
        with self._workspace_lock:   # current_zone is shared with the zone regen
            if self.map_data is None:
                self.current_zone = None
                self._clear_zone_preview()
                return
            if msg.data == "cancel**cancel**":
                self.np_show = self.map_data.np_assembled
                self.current_zone = None
                self._clear_zone_preview()
                return
            for zone in self.map_data.zones:
                if zone.msg.name == msg.data:
                    self.current_zone = zone
                    self.np_show = zone.np_zone
                    self._publish_zone_preview(zone)
                    self.log_publisher("Zone {} selected.".format(msg.data))
                    break
            else:
                self._clear_zone_preview()

    def map_zone_list_publisher(self):
        if self.map_data is not None:
            msg = MapEditZoneList()
            msg.header.stamp = rospy.Time.now()
            msg.header.frame_id = "map"
            msg.zone_list = []
            sorted_zones = sorted(self.map_data.zones, key=lambda x: x.msg.name)
            for zone in sorted_zones:
                msg.zone_list.append(zone.msg)
            self.zone_list_pub.publish(msg)

    def get_shapely_poly(self, polygons, contours, hierarchy, poly_id, external, internals):
        while poly_id != -1:
            contour = contours[poly_id].squeeze(axis=1)
            if len(contour) >= 3:
                first_child_id = hierarchy[poly_id][2]
                children = [] if external else None
                self.get_shapely_poly(polygons, contours, hierarchy, first_child_id, not external, children)
                if external:
                    polygon = geometry.Polygon(contour, holes=children)
                    polygons.append(polygon)
                else:
                    internals.append(contour)


            poly_id = hierarchy[poly_id][0]

    def create_paths_around(self):
        self.log_publisher("Creating outline paths...")
        image_copy = self.current_zone.np_zone_navi.copy()
        area_sum = 0
        for i in range(0, self.current_zone.msg.border_paths):
            inverted = cv2.bitwise_not(self.current_zone.np_zone_paths.view(np.uint8))
            inverted = np.where(inverted == 255, inverted, 0)
            contours, hierarchy = cv2.findContours(inverted, cv2.RETR_TREE, cv2.CHAIN_APPROX_NONE)
            if hierarchy is None:
                break
            polygons = []
            hierarchy = hierarchy[0]
            self.get_shapely_poly(polygons, contours, hierarchy, 0, True, [])
            for poly in polygons:
                ros_poly = self.convert_poly_to_ros_coord(poly)
                self.current_zone.path_polygons.append(PathPolygon(ros_poly, i))

                # Save area of the first path greater of 1/2 of the coverage diameter
                if i == 0:
                    mow_radius = MapSpec.COVERAGE_DIAMETER / 2
                    poly_b = ros_poly.buffer(mow_radius,
                                       join_style='round',
                                       mitre_limit=5.0,
                                       cap_style='flat',
                                       quad_segs=16)
                    area_sum += poly_b.area

                # Draw exterior to map
                points = [[x, y] for x, y in zip(*poly.exterior.coords.xy)]
                image_copy = cv2.polylines(image_copy, pts=np.array([points]).astype(np.int32),
                                           isClosed=True, color=90, thickness=1)

                for inner in poly.interiors:
                    # Draw interior holes to map
                    points = [[x, y] for x, y in zip(*inner.coords.xy)]
                    image_copy = cv2.polylines(image_copy, pts=np.array([points]).astype(np.int32),
                                               isClosed=True, color=120, thickness=1)

            # Obstacle margin
            shape_size = int(round(self.current_zone.msg.paths_distance / self.map_data.resolution))
            kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                                               (2 * shape_size + 1, 2 * shape_size + 1),
                                               (shape_size, shape_size))
            self.current_zone.np_zone_paths = cv2.dilate(self.current_zone.np_zone_paths.view(np.uint8), kernel, iterations=1)
            self.current_zone.np_zone_paths = self.current_zone.np_zone_paths.view(np.int8)
        self.current_zone.np_zone_paths = image_copy
        self.current_zone.msg.area = round(area_sum)

    def map_coord_to_ros_coord(self, points):
        output = []
        for point in points:
            point[0] = point[0] * self.map_data.resolution + self.map_data.origin_x
            point[1] = point[1] * self.map_data.resolution + self.map_data.origin_y
            output.append(point)
        return output


    def convert_poly_to_ros_coord(self, poly):
        points = [[x, y] for x, y in zip(*poly.exterior.coords.xy)]
        ext_coords = self.map_coord_to_ros_coord(points)
        holes = []
        for inner in poly.interiors:
            points2 = [[x, y] for x, y in zip(*inner.coords.xy)]
            in_coords = self.map_coord_to_ros_coord(points2)
            holes.append(in_coords)
        return geometry.Polygon(ext_coords, holes=holes)

    def marker_line_list_from_points(self, points, ns, id, color=None, scale=MapSpec.COVERAGE_DIAMETER):
        if color is None:
            color = [random.uniform(0.0, 1.0), random.uniform(0.0, 0.1), random.uniform(0.0, 0.1), 1.0]
        marker = Marker()
        marker.header.frame_id = "map"
        marker.header.stamp = rospy.Time.now()
        marker.ns = ns
        marker.type = Marker.LINE_LIST
        marker.id = id
        marker.scale.x = scale
        marker.scale.y = scale
        marker.scale.z = scale
        marker.color.r = color[0]
        marker.color.g = color[1]
