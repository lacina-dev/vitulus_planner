    def save_map(self, srv):
        if srv.name != "":
            self.current_navi_map_name = srv.name + "***env*" + srv.environment
            # self.callback_reload_map(Bool(True))
            self.map_sub.unregister()
            self.map_sub = rospy.Subscriber("/rtabmap/grid_map", OccupancyGrid, self.callback_map)
            self.data_loaded = False
            self.rtabmap_map_received = False
            while not self.rtabmap_map_received:
                rospy.sleep(0.5)
                rospy.loginfo("[{}] Planner wait for rtabmap.".format(rospy.get_caller_id()))
            rospy.loginfo("[{}] Planner rtabmap map received.".format(rospy.get_caller_id()))
            # self.callback_save_planner_data(Bool(True))
            if self.save_running_data() and exists(_RUNNING_PKL):
                shutil.copyfile(_RUNNING_PKL,
                                _saves_pkl(self.current_navi_map_name))
                self.log_publisher("Planner data saved.")
                rospy.loginfo("[{}] Planner data saved.".format(rospy.get_caller_id()))
                # Mirror zones + programs into the site bundle on map save.
                self._bundle_export_zones()
                self._bundle_export_programs()

            self.log_publisher("Planner map saved.")
            rospy.loginfo("[{}] Planner map saved.".format(rospy.get_caller_id()))
            return Save_mapResponse("OK", "Map " + self.current_navi_map_name + "saved.")
        else:
            self.log_publisher("Map name is empty.")
            rospy.logwarn("[{}] Map name is empty.".format(rospy.get_caller_id()))
            return Save_mapResponse("FAILED", "Map name is empty.")

    def clean_running_dir(self):
        if (exists(_RUNNING_PKL)):
            os.remove(_RUNNING_PKL)
            self.log_publisher("Running planner data cleaned.")
            rospy.loginfo("[{}] Running planner data cleaned.".format(rospy.get_caller_id()))

    def callback_reload_map(self, msg):
        if msg.data:
            self.map_sub.unregister()
            self.map_sub = rospy.Subscriber("/rtabmap/grid_map", OccupancyGrid, self.callback_map)
            self.data_loaded = False
            self.log_publisher("Be shure that you have loaded the map with RtabMap.")
            self.log_publisher("Reloading map from /rtabmap/grid_map")
            rospy.loginfo("[{}] Reloading map from /rtabmap/grid_map".format(rospy.get_caller_id()))

    def callback_load_planner_data(self, msg):
        if not msg.data:
            return
        # Serialised with every other workspace mutation (zone save/remove, the
        # live site_map refresh): a bundle import regenerates zones through the
        # shared self.current_zone / self.map_data.
        with self._workspace_lock:
            self._load_planner_data_locked()
        self._check_rules_behind()      # a pickle may hold zones of older rules

    def _load_planner_data_locked(self):
        if not self._legacy_maps():
            # ---- site-native (delegacy 2026-07-19): keyed on the SERVED site ----
            key = self._planner_key()            # served site name, or None
            if not key:
                self.log_publisher("No site served yet — planner data unavailable.")
                rospy.logwarn("[{}] Planner: no site served — cannot load planner "
                              "data yet (waits for /mapping_manager/status "
                              "serving.site).".format(rospy.get_caller_id()))
                return
            # Workspace of this site not complete yet (another site was loaded,
            # first load after boot, or an earlier attempt failed): full path.
            site_changed = (key != self._workspace_site)
            pkl_loaded = False
            if site_changed:
                # The saved pickle seeds the workspace ONLY on a site change; on a
                # plain reload the memory state is the truth (the pickle is kept
                # in sync by save_running_data, never newer).
                pkl = _saves_pkl(key)
                if self._raster_site != key and exists(pkl):
                    shutil.copyfile(pkl, _RUNNING_PKL)
                    pkl_loaded = self.load_running_data(" (site '{}')".format(key))
                if pkl_loaded:
                    self._raster_site = key
                    self.current_zone = None
                elif self._raster_site != key:
                    # No (valid) saved planner_data for this site yet — build a
                    # fresh workspace from the served raster below.
                    rospy.loginfo("[{}] Planner: no saved planner_data for served site "
                                  "'{}' — building fresh from the served raster.".format(
                                      rospy.get_caller_id(), key))
            # site_native (2): (re)build the zone-generation workspace raster from
            # the served site_map. This CREATES map_data even when there was no
            # pickle, so zone regen / bundle import run against the site free space.
            # The in-memory zones are carried over ONLY when they belong to this
            # site — never leak the previous site's zones (they would even get
            # exported into this site's bundle).
            if self._rebuild_map_from_site_grid(carry=(self._raster_site == key)):
                self._raster_site = key
            elif self._raster_site != key:
                # Nothing could be built for the new site: drop the previous
                # site's workspace rather than keep serving its zones.
                self.map_data = None
                self.current_zone = None
                self._raster_site = None
            self.data_loaded = self.map_data is not None
            # Bundle-wins: rebuild zones/programs from the site bundle when newer.
            # FORCED for a newly served site WITHOUT a saved pickle: nothing in
            # memory reflects this site's bundle yet (the import stamp only says
            # "seen before"). With a pickle the stamp/mtime test decides (A4).
            zones_ok = self._bundle_import_if_newer(
                force=(site_changed and not pkl_loaded))
            if self._raster_site == key and zones_ok:
                if site_changed:
                    self.save_running_data()   # seed saves/<site>.pkl (A4)
                self._workspace_site = key
            else:
                self._workspace_site = None
                rospy.logwarn("[{}] Planner workspace for site '{}' is NOT complete "
                              "(raster: {}, zones: {}) — retried on the next site_map "
                              "/ reload.".format(rospy.get_caller_id(), key,
                                                 self._raster_site == key, zones_ok))
            if site_changed:
                self._clear_zone_preview()
                self.map_zone_list_publisher()
                self.map_poly_list_publisher()
                self.program_list_publisher()
            self._planner_loaded = key
            self.planner_loaded_pub.publish(String(key))
            return
        # ---- legacy path (legacy_maps=True): keyed on active navi map name ----
        if self.current_navi_map_name != "New":
            if (exists(_saves_pkl(self.current_navi_map_name))):
                shutil.copyfile(_saves_pkl(self.current_navi_map_name),
                                _RUNNING_PKL)
                self.data_loaded = self.load_running_data()
                if not self.data_loaded:
                    self.log_publisher("Planner data NOT loaded (saved data unusable).")
                # site_native (2): rebuild the zone-generation workspace raster
                # from the served site raster BEFORE the bundle zone/program
                # import, so any zone regen runs against the site free space.
                if self.data_loaded:
                    self._rebuild_map_from_site_grid()
                # Bundle-wins: if the site bundle is newer than the just-loaded
                # pickles, rebuild zones/programs from it (UTM -> map, regen).
                self._bundle_import_if_newer()
                self._planner_loaded = self.current_navi_map_name
                self.planner_loaded_pub.publish(String(self.current_navi_map_name))
        else:
            self.log_publisher("Not loaded!!! It's a new map. Save it in Navi Manager first.")
            rospy.logwarn("[{}] Not loaded!!! It's a new map.".format(rospy.get_caller_id()))

    def callback_save_planner_data(self, msg):
        if not msg.data:
            return
        # Pickle key: served site in site-native, active navi map name in legacy.
        key = self._planner_key()
        if not key or key == "New":
            self.log_publisher("Not saved!!! No site served / new map. Save it in "
                               "Navi Manager first.")
            rospy.logwarn("[{}] Planner data not saved (no served site / new "
                          "map).".format(rospy.get_caller_id()))
            return
        if not self.save_running_data():
            self.log_publisher("Not saved!!! No planner workspace (no map is active).")
            rospy.logwarn("[{}] Planner data not saved (no workspace / write "
                          "failed).".format(rospy.get_caller_id()))
            return
        if (exists(_RUNNING_PKL)):
            shutil.copyfile(_RUNNING_PKL,
                            _saves_pkl(key))
            self.log_publisher("Planner data saved.")
            rospy.loginfo("[{}] Planner data saved (key '{}').".format(
                rospy.get_caller_id(), key))
            # Mirror zones + programs into the site bundle on explicit save.
            self._bundle_export_zones()
            self._bundle_export_programs()

