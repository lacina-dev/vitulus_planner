    def _regenerate_zone(self, msg):
        """Build a Zone from a MapEditZone msg and store it in map_data.zones (add
        or replace by name). Sets self.current_zone. Returns the Zone.

        Shared by the live save_zone handler and the site-bundle import path —
        regeneration MUST go through this single code path so imported zones get
        identical coverage.
        """
        self._generate_zone(msg)

        # Save or update current zone
        zone_exist = False
        zone_exist_id = -1
        i = 0
        for z in self.map_data.zones:
            if z.msg.name == msg.name:
                zone_exist = True
                zone_exist_id = i
            i += 1
        if not zone_exist:
            self.map_data.zones.append(self.current_zone)
        else:
            self.map_data.zones[zone_exist_id] = self.current_zone
        return self.current_zone

    def _rule_px(self, x, y):
        """Map metres -> (col, row), the way a zone polygon is rasterized."""
        return (self.map_data.x_origin + int(x / self.map_data.resolution),
                self.map_data.y_origin + int(y / self.map_data.resolution))

    def _coverage_rules(self):
        """Active nogo / noblade of the map the workspace holds. A list from
        another site (site switch in progress) shapes nothing."""
        site, rules = self._map_rules
        if site is None or site in (self._raster_site, self._bundle_site()):
            return rules
        return []

    def _zone_rules(self, zmsg):
        """The rules that bear on a zone (MapEditZone)."""
        return coverage_rules.rules_of_zone(
            self._coverage_rules(),
            [(p.x, p.y) for p in zmsg.polygon.polygon.points])

    def _gen_check(self):
        """Between the steps of a generation: stop a superseded dry run."""
        if self._gen_cancelled is not None and self._gen_cancelled():
            raise coverage_rules.Cancelled()

    def _generate_zone(self, msg):
        """Mask layers + outline/coverage paths of a MapEditZone msg, stored
        nowhere but self.current_zone. Returns the Zone."""
        polygon = []
        for point in msg.polygon.polygon.points:
            x_point = int(point.x / self.map_data.resolution)
            y_point = int(point.y / self.map_data.resolution)
            polygon.append([self.map_data.x_origin + x_point, self.map_data.y_origin + y_point])
        np_polygon = np.array(polygon)

        # make zone polygon smaller by cut coverage radius
        shape_poly = geometry.Polygon(np_polygon)
        cut_margin_dist = int(round((MapSpec.COVERAGE_DIAMETER / 2) / self.map_data.resolution))
        shape_poly = shape_poly.buffer(-cut_margin_dist)
        pointarray = []
        for point in shape_poly.exterior.coords:
            pointarray.append([int(point[0]), int(point[1])])
        np_polygon_mow = np.array(pointarray)

        # draw polygon on zone layer
        np_zone = np.zeros_like(self.map_data.np_assembled)
        cv2.fillPoly(np_zone, pts=[np_polygon_mow], color=MapSpec.OBSTACLE)
        np_zone = np.where(np_zone == MapSpec.OBSTACLE, self.map_data.np_assembled, MapSpec.OBSTACLE)

        # Map rules: coverage only. np_zone_navi below stays, noblade is passable.
        rules = self._zone_rules(msg)
        coverage_rules.stamp(
            np_zone, rules, self._rule_px, self.map_data.obstacle_margin_px,
            int(round(self._nogo_extra_m / self.map_data.resolution)), MapSpec.OBSTACLE)

        # make zone polygon bigger by obstacle margin and draw zone map for navi
        shape_poly = geometry.Polygon(np_polygon)
        shape_poly = shape_poly.buffer(self.map_data.obstacle_margin_px, cap_style='flat', join_style='mitre')
        pointarray = []
        for point in shape_poly.exterior.coords:
            pointarray.append([int(point[0]), int(point[1])])
        np_polygon_navi = np.array(pointarray)

        # draw polygon on navi zone layer
        np_zone_navi = np.zeros_like(self.map_data.np_assembled)
        cv2.fillPoly(np_zone_navi, pts=[np_polygon_navi], color=MapSpec.OBSTACLE)
        np_zone_navi = np.where(np_zone_navi == MapSpec.OBSTACLE, self.map_data.np_semi_assembled, MapSpec.OBSTACLE)
        zone = Zone(np_zone, np_zone_navi, msg)
        zone.rules_fp = coverage_rules.fingerprint(rules)
        # Store first clicked point as start reference (ROS map frame, metres)
        if len(msg.polygon.polygon.points) > 0:
            zone.start_point = geometry.Point(msg.polygon.polygon.points[0].x,
                                              msg.polygon.polygon.points[0].y)

        # Create paths around zone and coverage paths
        self.current_zone = zone
        self.create_paths_around()
        self._gen_check()
        self.current_zone.msg.paths = []
        self.current_zone.msg.length = 0
        self.create_outline_path_msg()
        self.create_coverage_paths()
        self._gen_check()
        self.create_coverage_path_msg()
        self.current_zone.msg.length = int(round(self.current_zone.msg.length))
        # print("Zone path length: {}".format(self.current_zone.msg.length))
        return self.current_zone

    def _has_workspace(self):
        """A usable planner workspace exists. Site-native: only while a site is
        served — a workspace left in memory with nothing served belongs to no
        bundle, so an edit on it would be confirmed and then lost."""
        if self.map_data is None:
            return False
        return self._legacy_maps() or bool(self._planner_key())

    def _drop_workspace(self):
        """Serving stopped (site-native): forget the previous site's workspace —
        the same state as a boot with nothing served — and tell the UI the zone
        and polygon lists are empty. saves/<site>.pkl and the site bundle are
        untouched; they load again when the site is served. Programs keep their
        own per-site handling. Caller holds the workspace lock."""
        self.map_data = None
        self.current_zone = None
        self._raster_site = None
        self._workspace_site = None
        self._clear_zone_preview()
        zones = MapEditZoneList()
        zones.header.stamp = rospy.Time.now()
        zones.header.frame_id = "map"
        self.zone_list_pub.publish(zones)
        polys = MapEditPolygonList()
        polys.header.stamp = rospy.Time.now()
        polys.header.frame_id = "map"
        self.map_poly_list_pub.publish(polys)

    def _ensure_workspace(self, what, report=True):
        """True when a planner workspace (map_data) exists. When it does not but
        a site IS served (site-native), try to build it right now from the served
        raster (same path a site change takes) instead of failing. Otherwise
        report `what` + the reason to the UI log and return False — never throw
        inside a rospy callback (the request would be lost silently).
        report=False: the caller reports the failure itself."""
        if self._has_workspace():
            return True
        if not self._legacy_maps() and self._planner_key():
            rospy.loginfo("[{}] No planner workspace yet — building it from the "
                          "served site '{}'.".format(rospy.get_caller_id(),
                                                     self._planner_key()))
            try:
                self.callback_load_planner_data(Bool(True))
            except Exception as e:
                rospy.logerr("[{}] Lazy workspace build failed: {}".format(
                    rospy.get_caller_id(), e))
            if self.map_data is not None:
                return True
        if report:
            text = "{}: no map is active — activate or record a map first.".format(what)
            self.log_publisher(text)
            rospy.logerr("[{}] {}".format(rospy.get_caller_id(), text))
        return False

    def _zone_result(self, op, name, ok, message, programs=0):
        """Unambiguous outcome of a zone save/remove for the UI: a JSON String on
        /web_plan/zone_result {"op": "save"|"remove", "name", "ok", "message",
        "programs"} (published AFTER the latched zone_list update on success),
        plus the same text on /web_plan/log. programs = how many saved programs
        got the new zone."""
        self.log_publisher(message)
        if not ok:
            rospy.logerr("[{}] {}".format(rospy.get_caller_id(), message))
        self.zone_result_pub.publish(String(json.dumps(
            {"op": op, "name": name, "ok": bool(ok), "message": message,
             "programs": programs})))

    def callback_map_save_zone(self, msg):
        # /web_plan/zone_result contract: exactly ONE result for EVERY attempt,
        # on success published after the latched zone_list update.
        ok = False
        programs = 0
        text = "Zone '{}' NOT saved: internal planner error.".format(msg.name)
        try:
            ok, text, programs = self._save_zone(msg)
        except Exception as e:
            rospy.logerr("[{}] Zone '{}' save failed: {}".format(
                rospy.get_caller_id(), msg.name, e))
        finally:
            self._zone_result("save", msg.name, ok, text, programs)

    def _zone_save_refusal(self, name):
        """Why a zone must not change now, or None. Programs embed a copy of their
        zones: a save during a swap would miss the programs of this map, and a
        running mission would continue on a shape its program no longer has."""
        if not self._programs_usable():
            return ("Zone '{}' NOT saved: the programs of the active map are not "
                    "loaded yet — try again in a moment.".format(name))
        program = self._running_program_on(name)
        if program:
            return ("Zone '{}' NOT saved: program '{}' is running on it — stop "
                    "it first.".format(name, program))
        return None

    def _running_program_on(self, name):
        """Name of the running program that mows zone `name`, or None."""
        programs = (self.permanent_program_list_msg.program_list
                    if self.permanent_program_list_msg is not None else [])
        for p in programs:
            if (self._on_current_map(p) and self._program_is_running(p.name)
                    and any(z.name == name for z in p.zone_list)):
                return p.name
        return None

    def _save_zone(self, msg):
        """Returns (ok, message for the UI, programs updated)."""
        if not self._ensure_workspace("Zone '{}' NOT saved".format(msg.name),
                                      report=False):
            return False, ("Zone '{}' NOT saved: no map is active — activate or "
                           "record a map first.".format(msg.name)), 0
        # The whole save runs under the workspace lock and works on the zone
        # object returned by the regen — self.current_zone is shared with the
        # live-refresh worker and the zone selection.
        with self._workspace_lock:   # AUDIT #10
            refusal = self._zone_save_refusal(msg.name)
            if refusal:
                return False, refusal, 0
            if not coverage_rules.cut_height_ok(msg.cut_height):
                return False, ("Zone '{}' NOT saved: cut height {} mm is outside "
                               "{}.".format(msg.name, msg.cut_height,
                                            coverage_rules.cut_height_text())), 0
            before = list(self.map_data.zones)
            try:
                zone = self._regenerate_zone(msg)
            except Exception as e:
                # e.g. a polygon too small / outside the map: the zone list is
                # untouched (the zone is stored only at the end of the regen).
                self.current_zone = None
                self._clear_zone_preview()
                rospy.logerr("[{}] Zone '{}' regeneration failed: {}".format(
                    rospy.get_caller_id(), msg.name, e))
                return False, ("Zone '{}' NOT saved: mowing paths could not be "
                               "generated — the zone is too small or lies outside "
                               "the map.".format(msg.name)), 0
            if not zone.msg.paths:
                # The zone a program mows would be gone, and only at the next
                # start would anybody learn why. The stored zone stays.
                self.map_data.zones = before
                self.current_zone = None
                self._clear_zone_preview()
                return False, ("Zone '{}' NOT saved: this shape leaves no mowing "
                               "path — it is too small or lies outside the free "
                               "space of the map.".format(msg.name)), 0
            self.map_zone_list_publisher()
            # Show zone map
            self.np_show = zone.np_zone_paths
            self._publish_zone_preview(zone)
            # Push the edited zone (new shape/route) into existing programs that use
            # it, so a map change is reflected without rebuilding the programs.
            updated = self._propagate_zone_to_programs(zone.msg)
            self.program_list_publisher()
            self.save_running_data()
            # Mirror the workspace zones into the site bundle (UTM, bundle-wins).
            self._bundle_export_zones()
        return True, "Zone {} saved.".format(zone.msg.name), updated

    def callback_zone_rename(self, msg):
        """Payload JSON {from, to}; exactly one result on the rename result topic."""
        old, new, code = '', '', 'failed'
        try:
            old, new = objnames.parse_request(msg.data)
            code = self._rename_zone(old, new)
        except ValueError:
            code = 'bad_request'
        except Exception as e:
            rospy.logerr("[{}] Zone '{}' rename failed: {}".format(
                rospy.get_caller_id(), old, e))
            code = 'failed'
        finally:
            self.rename_result_pub.publish(String(
                objnames.result_json('zone', old, new, code)))

    def _rename_zone(self, old, new):
        """Rename in the workspace, the bundle and every program that uses the zone
        (programs join zones by name). Returns a rename result code."""
        if not self._has_workspace():
            return 'no_site'
        if not self._programs_usable():
            return 'busy'           # programs of another site, a swap is pending
        with self._workspace_lock:
            site = self._bundle_site()
            if site and not self._workspace_is_of(site, "zone '{}' NOT renamed".format(old)):
                return 'busy'
            bundled = (vbundle.load_zones(site) or []) if site else []
            names = {z.msg.name for z in self.map_data.zones}
            names.update(z.get('name') for z in bundled)
            code = objnames.check_rename(old, new, list(names))
            if code:
                return code
            programs = (self.permanent_program_list_msg.program_list
                        if self.permanent_program_list_msg is not None else [])
            users = [p for p in programs
                     if self._on_current_map(p) and any(z.name == old for z in p.zone_list)]
            if any(self._program_is_running(p.name) for p in users):
                return 'busy'
            for z in self.map_data.zones:
                if z.msg.name == old:
                    z.msg.name = new
            if self.current_zone is not None and self.current_zone.msg.name == old:
                self.current_zone.msg.name = new
            # The bundle first: the programs export keeps a stored zone name only
            # while zones.geojson still holds it.
            if any(z.get('name') == old for z in bundled):
                for z in bundled:
                    if z.get('name') == old:
                        z['name'] = new
                vbundle.save_zones(site, bundled)
                self._touch_bundle_stamp(site, 'zones')
            for p in users:
                for z in p.zone_list:
                    if z.name == old:
                        z.name = new
            self.map_zone_list_publisher()
            self.save_running_data()
            if users:
                self.save_programs()
                self.program_list_publisher()
                self._bundle_export_programs()
            self._bundle_export_zones()
        self.log_publisher("Zone '{}' renamed to '{}'.".format(old, new))
        return 'ok'

    def callback_zone_remove(self, msg):
        ok = False
        text = "Zone '{}' NOT removed: internal planner error.".format(msg.data)
        try:
            ok, text = self._remove_zone(msg.data)
        except Exception as e:
            rospy.logerr("[{}] Zone '{}' remove failed: {}".format(
                rospy.get_caller_id(), msg.data, e))
        finally:
            self._zone_result("remove", msg.data, ok, text)

    def _remove_zone(self, name):
        """Returns (ok, message for the UI)."""
        if not self._has_workspace():
            return False, "Zone '{}' NOT removed: no map is active.".format(name)
        with self._workspace_lock:   # AUDIT #10
            # Remove zone
            self.map_data.zones = [z for z in self.map_data.zones
                                   if z.msg.name != name]
            self.map_zone_list_publisher()
            if self.current_zone is not None and self.current_zone.msg.name == name:
                self.current_zone = None
            self._clear_zone_preview()
            # AUDIT A2 (2026-08-01): the merge export below preserves bundle-only
            # zones BY DESIGN, so a plain export would resurrect the deleted zone
            # on the next import. Delete it from the bundle file explicitly —
            # BEFORE the programs export, whose zone-name merge keeps names that
            # still exist in zones.geojson.
            self._bundle_remove_zone(name)
            # Drop the removed zone from existing programs that referenced it.
            self._remove_zone_from_programs(name)
            self.program_list_publisher()
            # Show map
            self.np_show = self.map_data.np_assembled
            self.save_running_data()
            # Reflect the removal in the site bundle.
            self._bundle_export_zones()
        return True, "Zone {} removed.".format(name)

    # ---- /web_plan/zone_check: dry run ------------------------------------
    def _zone_generator(self, cancelled=None, dry=False):
        """A private view of this node for generating zones: the real path code,
        with its own current_zone and a frozen view of the raster layers, so
        nothing a generation does can reach the workspace or the UI log. Call
        with the workspace lock held; use it without."""
        gen = copy.copy(self)
        gen.map_data = copy.copy(self.map_data)
        gen.current_zone = None
        gen.log_publisher = lambda text: None
        gen._gen_cancelled = cancelled
        gen._gen_dry = dry
        return gen

    def callback_zone_check(self, msg):
        """Only hands over: path generation takes seconds. Every request gets one
        result; a newer one supersedes it, before or during its run."""
        try:
            req = json.loads(msg.data)
            if not isinstance(req, dict):
                raise ValueError('expected a JSON object')
        except ValueError:
            self._zone_check_publish(self._zone_check_out(
                {}, [coverage_rules.problem('bad_request')]))
            return
        with self._zone_check_lock:
            self._zone_check_seq += 1
            dropped = self._zone_check_next
            self._zone_check_next = (self._zone_check_seq, req)
            start = not self._zone_check_active
            self._zone_check_active = True
        if dropped is not None:
            self._zone_check_publish(self._zone_check_cancelled(dropped[1]))
        if start:
            t = threading.Thread(target=self._zone_check_worker, name="zone_check")
            t.daemon = True
            t.start()

    def _zone_check_worker(self):
        while True:
            with self._zone_check_lock:
                item = self._zone_check_next
                self._zone_check_next = None
                if item is None:
                    self._zone_check_active = False
                    return
            seq, req = item
            try:
                out = self._zone_check(
                    req, lambda: seq != self._zone_check_seq)
            except coverage_rules.Cancelled:
                out = self._zone_check_cancelled(req)
            except Exception as e:
                rospy.logerr("[{}] Zone check failed: {}".format(rospy.get_caller_id(), e))
                out = self._zone_check_out(req, [coverage_rules.problem('internal')])
            try:
                self._zone_check_publish(out)
            except Exception as e:
                rospy.logerr("[{}] Zone check result lost: {}".format(
                    rospy.get_caller_id(), e))

    def _zone_check_publish(self, out):
        self.zone_check_result_pub.publish(String(json.dumps(out)))

    def _zone_check_out(self, req, problems):
        return {"req": req.get("req"), "ok": not coverage_rules.has_errors(problems),
                "mowable_m2": 0.0, "unreachable_m2": 0.0, "length_m": 0.0,
                "minutes": 0, "preview": [], "problems": problems}

    def _zone_check_cancelled(self, req):
        out = self._zone_check_out(req, [])
        out.update(ok=False, cancelled=True)
        return out

    def _zone_check_props(self, settings):
        """Zone props of a request; what it leaves out as the editor's defaults."""
        props = {'type': 'normal', 'border_paths': 2, 'coverage_angle': 0,
                 'paths_distance': 0.2, 'simplify': 0.1, 'cut_height': 0, 'rpm': 0}
        for key in ('border_paths', 'coverage_angle', 'cut_height', 'rpm'):
            if settings.get(key) is not None:
                props[key] = int(settings[key])
        for key in ('paths_distance', 'simplify'):
            if settings.get(key) is not None:
                props[key] = float(settings[key])
        if settings.get('type'):
            props['type'] = str(settings['type'])
        return props

    def _zone_check_runs(self):
        """Past runs of the programs of this map, for the minutes estimate."""
        programs = (self.permanent_program_list_msg.program_list
                    if self.permanent_program_list_msg is not None else [])
        return [{'length': p.length, 'minutes': p.last_duration_minutes,
                 'speed': (p.speed or 'mid').lower(), 'result': p.last_result,
                 'zones': [z.name for z in p.zone_list]}
                for p in programs if self._on_current_map(p)]

    def _zone_check_home(self):
        """Where the robot starts from, map frame, or None: UNDOCK (the dock
        itself may lie inside the obstacle margin), else DOCK."""
        try:
            site = self._bundle_site()
            datum = self._active_map_datum() if site else None
            if datum is None:
                return None
            points = {(w.get('name') or '').upper(): w
                      for w in vbundle.load_waypoints(site) or []}
            w = points.get('UNDOCK') or points.get('DOCK')
            return vgeo.utm_to_map(w['e'], w['n'], datum) if w else None
        except Exception as e:
            rospy.logwarn("[{}] Zone check: no start point ({}).".format(
                rospy.get_caller_id(), e))
            return None

    def _zone_check(self, req, cancelled):
        """Everything a save of this zone would do, up to the save. Result of
        /web_plan/zone_check; problems see coverage_rules.problem()."""
        problem = coverage_rules.problem
        settings = req.get('settings') if isinstance(req.get('settings'), dict) else {}
        name = str(req.get('name') or settings.get('name') or '').strip()
        points, shape, problems = coverage_rules.read_shape(req.get('points'))
        try:
            props = self._zone_check_props(settings)
        except (TypeError, ValueError):
            problems.append(problem('bad_settings'))
            return self._zone_check_out(req, problems)
        problems.extend(coverage_rules.settings_problems(props))
        with self._workspace_lock:
            if not self._has_workspace():
                problems.append(problem('no_map'))
                return self._zone_check_out(req, problems)
            if not self._programs_usable():
                problems.append(problem('programs_not_loaded'))
            elif name and self._running_program_on(name):
                problems.append(problem('program_running',
                                        program=self._running_program_on(name)))
            zones = [(z.msg.name, [(p.x, p.y) for p in z.msg.polygon.polygon.points])
                     for z in self.map_data.zones if z.msg.name != name]
            if _BUNDLE_OK and name:
                code = objnames.check_name(name, [z[0] for z in zones])
                if code:
                    problems.append(problem('name_' + code, name=name))
            rules = self._coverage_rules()
            runs = self._zone_check_runs()
            gen = self._zone_generator(cancelled, dry=True)
        if coverage_rules.has_errors(problems) or shape is None:
            return self._zone_check_out(req, problems)

        zmsg = self._bundle_build_zone_msg(name, points, props)
        data = gen.map_data
        try:
            zone = gen._generate_zone(zmsg)
        except coverage_rules.Cancelled:
            raise
        except Exception as e:
            rospy.loginfo("[{}] Zone check: no paths for this shape ({}).".format(
                rospy.get_caller_id(), e))
            problems.append(problem('no_path'))
            return self._zone_check_out(req, problems)
        if not zone.msg.paths:
            problems.append(problem('no_path'))

        rows, cols = data.np_assembled.shape
        x1 = data.origin_x + cols * data.resolution
        y1 = data.origin_y + rows * data.resolution
        if (shape.bounds[0] < data.origin_x or shape.bounds[1] < data.origin_y
                or shape.bounds[2] > x1 or shape.bounds[3] > y1):
            problems.append(problem('outside_map', 'warning'))
        for rule in rules:
            over = coverage_rules.overlap_area(shape, rule['points'])
            if over >= 0.01:
                problems.append(problem('overlaps_' + rule['type'], 'warning',
                                        name=rule['name'], area_m2=round(over, 2)))
        for other, outline in zones:
            if len(outline) >= 3:
                over = coverage_rules.overlap_area(shape, outline)
                if over >= 0.01:
                    problems.append(problem('overlaps_zone', 'warning', name=other,
                                            area_m2=round(over, 2)))

        # Parts of the zone the path code really uses, and whether the robot gets
        # there: nogo blocks driving, noblade does not.
        parts = gen.filter_list_of_polygons(gen.get_first_level_outline_poly())
        if len(parts) > 1:
            problems.append(problem('zone_split', 'warning', parts=len(parts)))
        navi = np.copy(data.np_assembled)
        coverage_rules.stamp(navi, [r for r in rules if r['type'] == 'nogo'],
                             gen._rule_px, data.obstacle_margin_px, 0, MapSpec.OBSTACLE)
        cut_off = coverage_rules.cut_off_parts(
            parts, navi == MapSpec.FREE, gen._rule_px, self._zone_check_home())
        radius = MapSpec.COVERAGE_DIAMETER / 2
        mowable = 0.0
        for i, part in enumerate(parts):
            area = part.buffer(radius).intersection(shape).area
            if i in cut_off:
                problems.append(problem('part_unreachable', 'warning',
                                        area_m2=round(area, 2)))
            else:
                mowable += area
        gen._gen_check()

        speed = settings.get('speed')
        if not speed:
            speed = next((r['speed'] for r in runs if name and name in r['zones']), 'mid')
        minutes, source = coverage_rules.estimate_minutes(zone.msg.length, str(speed),
                                                          runs, name)
        out = self._zone_check_out(req, problems)
        out.update(
            mowable_m2=round(mowable, 1),
            unreachable_m2=round(max(0.0, shape.area - mowable), 1),
            length_m=zone.msg.length, minutes=minutes, minutes_source=source,
            preview=coverage_rules.thin_preview(
                [[(q.pose.position.x, q.pose.position.y) for q in path.poses]
                 for path in zone.msg.paths]))
        return out

    # ---- /web_plan/zone_op: split / merge / duplicate ----------------------
    def callback_zone_op(self, msg):
        """Exactly one result on /web_plan/zone_op_result for every attempt:
        {"req","op","ok","code","reason","names","removed","programs"}. code is
        'ok' or the machine form of the refusal; on a refusal nothing changed."""
        out = {"req": None, "op": None, "ok": False, "code": "failed",
               "reason": "Zone operation failed: internal planner error.",
               "names": [], "removed": [], "programs": 0}
        try:
            req = json.loads(msg.data)
            if not isinstance(req, dict):
                raise ValueError('expected a JSON object')
            out.update(req=req.get('req'), op=req.get('op'))
            out.update(self._zone_op(req))
        except ValueError:
            out.update(code='bad_request', reason="Zone operation: bad request.")
        except Exception as e:
            rospy.logerr("[{}] Zone operation failed: {}".format(rospy.get_caller_id(), e))
        finally:
            self.log_publisher(out['reason'])
            if not out['ok']:
                rospy.logerr("[{}] {}".format(rospy.get_caller_id(), out['reason']))
            self.zone_op_result_pub.publish(String(json.dumps(out)))

    _ZONE_OP_TEXT = {
        'bad_request': "the request is not complete",
        'no_map': "no map is active — activate or record a map first",
        'programs_not_loaded': "the programs of the active map are not loaded yet "
                               "— try again in a moment",
        'not_found': "zone '{zone}' is not on the active map",
        'program_running': "program '{program}' is running on zone '{zone}' — stop "
                           "it first",
        'other_map': "the planner still holds another map — try again in a moment",
        'cut_height_range': "cut height {value} mm of zone '{zone}' is outside {range}",
        'bad_line': "the line is not usable",
        'line_misses_zone': "the line does not cross the zone",
        'split_not_two_parts': "the line cuts the zone in more than two parts",
        'self_intersecting': "the outline crosses itself",
        'not_adjacent': "the zones do not touch",
        'merge_has_hole': "the zones enclose a hole, and a zone cannot have one",
        'name': "name '{zone}' cannot be used ({detail})",
        'no_path': "zone '{zone}' would have no mowing path — it is too small or "
                   "lies outside the free space of the map",
    }

    def _zone_op_refuse(self, op, code, **params):
        return {"ok": False, "code": code, "reason": "Zone {} refused: {}.".format(
            op, self._ZONE_OP_TEXT[code].format(**params))}

    def _zone_op_names(self, req, op):
        if op == 'merge':
            names = req.get('names')
            if not isinstance(names, list):
                return []
            names = [str(n) for n in names]
            return names if len(names) >= 2 and len(set(names)) == len(names) else []
        return [str(req['name'])] if req.get('name') else []

    def _zone_op_plan(self, req, op, names, outlines, taken):
        """(spec, code): spec = {'parts': [(name, outline)], 'replaced': [names]}.
        Every part takes the settings of the first zone."""
        first = names[0]
        if op == 'duplicate':
            new = str(req.get('new_name') or '').strip()
            return {'parts': [(new or coverage_rules.unique_name(first + ' copy', taken),
                               outlines[first])], 'replaced': []}, None
        if op == 'merge':
            shape, code = coverage_rules.merge_zones([outlines[n] for n in names])
            if code:
                return None, code
            new = str(req.get('new_name') or '').strip() or first
            return {'parts': [(new, shape)], 'replaced': names}, None
        parts, code = coverage_rules.split_zone(outlines[first], req.get('line'))
        if code:
            return None, code
        wanted = [str(n).strip() for n in req.get('new_names') or [] if str(n).strip()]
        if len(wanted) >= 2:
            pair = wanted[:2]
        else:
            pair = [first, wanted[0] if wanted
                    else coverage_rules.unique_name(first + ' 2', taken)]
        return {'parts': list(zip(pair, parts)), 'replaced': [first]}, None

    def _zone_op(self, req):
        op = req.get('op')
        if op not in ('split', 'merge', 'duplicate'):
            return {"code": "bad_request", "reason": "Zone operation: unknown op."}
        names = self._zone_op_names(req, op)
        if not names:
            return self._zone_op_refuse(op, 'bad_request')
        if not self._ensure_workspace("Zone {}".format(op), report=False):
            return self._zone_op_refuse(op, 'no_map')
        # Same rules as a zone save, for every zone it touches, and everything is
        # generated before anything changes.
        with self._workspace_lock:
            if not self._programs_usable():
                return self._zone_op_refuse(op, 'programs_not_loaded')
            site = self._bundle_site()
            if site and not self._workspace_is_of(site, "zone {} refused".format(op)):
                return self._zone_op_refuse(op, 'other_map')
            zones = {z.msg.name: z for z in self.map_data.zones}
            for name in names:
                if name not in zones:
                    return self._zone_op_refuse(op, 'not_found', zone=name)
                program = self._running_program_on(name)
                if program:
                    return self._zone_op_refuse(op, 'program_running', zone=name,
                                                program=program)
                height = zones[name].msg.cut_height
                if not coverage_rules.cut_height_ok(height):
                    return self._zone_op_refuse(
                        op, 'cut_height_range', zone=name, value=height,
                        range=coverage_rules.cut_height_text())
            taken = list(zones)
            if site:
                taken += [z.get('name') for z in (vbundle.load_zones(site) or [])]
            outlines = {n: [(p.x, p.y) for p in zones[n].msg.polygon.polygon.points]
                        for n in names}
            spec, code = self._zone_op_plan(req, op, names, outlines, taken)
            if code:
                return self._zone_op_refuse(op, code)
            free_names = [n for n in taken if n not in spec['replaced']]
            built = []
            gen = self._zone_generator()
            for name, shape in spec['parts']:
                if _BUNDLE_OK:
                    code = objnames.check_name(name, free_names)
                    if code:
                        return self._zone_op_refuse(op, 'name', zone=name, detail=code)
                free_names.append(name)
                zmsg = copy.deepcopy(zones[names[0]].msg)
                zmsg.name = name
                zmsg.polygon.polygon.points = [Point32(float(x), float(y), 0.0)
                                               for x, y in shape]
                try:
                    zone = gen._generate_zone(zmsg)
                except Exception as e:
                    rospy.logwarn("[{}] Zone {}: '{}' regeneration failed: {}".format(
                        rospy.get_caller_id(), op, name, e))
                    return self._zone_op_refuse(op, 'no_path', zone=name)
                if not zone.msg.paths:
                    return self._zone_op_refuse(op, 'no_path', zone=name)
                built.append(zone)
            return self._zone_op_commit(op, spec, built)

    def _zone_op_commit(self, op, spec, built):
        """Workspace, bundle, programs, lists. Caller holds the workspace lock."""
        new_names = [z.msg.name for z in built]
        removed = [n for n in spec['replaced'] if n not in new_names]
        self.map_data.zones = [z for z in self.map_data.zones
                               if z.msg.name not in spec['replaced']] + built
        self.current_zone = None
        self._clear_zone_preview()
        self.np_show = self.map_data.np_assembled
        self.map_zone_list_publisher()
        self.save_running_data()
        # The bundle first: the programs export keeps a stored zone name only while
        # zones.geojson still holds it, and the merge export keeps what it finds.
        for name in removed:
            self._bundle_remove_zone(name)
        self._bundle_export_zones()
        programs = self._zone_op_programs(spec, built)
        text = "Zone {} done: {}.".format(op, ', '.join(new_names))
        return {"ok": True, "code": "ok", "reason": text, "names": new_names,
                "removed": removed, "programs": programs}

    def _zone_op_programs(self, spec, built):
        """Programs that used a replaced zone now mow what took its place, at the
        same position in their order. Returns how many changed."""
        replaced = set(spec['replaced'])
        if self.permanent_program_list_msg is None or not replaced:
            return 0
        fresh = [z.msg for z in built]
        changed = 0
        for program in self.permanent_program_list_msg.program_list:
            if (not self._on_current_map(program)
                    or not any(z.name in replaced for z in program.zone_list)):
                continue
            zone_list = []
            for z in program.zone_list:
                for item in (fresh if z.name in replaced else [z]):
                    if all(item.name != have.name for have in zone_list):
                        zone_list.append(copy.deepcopy(item))
            program.zone_list = zone_list
            program.area = min(int(sum(z.area for z in zone_list)), 32767)
            program.length = min(int(sum(z.length for z in zone_list)), 32767)
            changed += 1
        if changed:
            self.save_programs()
            self.program_list_publisher()
            self._bundle_export_programs()
        return changed

