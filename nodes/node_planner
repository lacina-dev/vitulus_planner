_SAVES_DIR = os.path.join(_VITULUS_DIR, 'saves', 'planner_data')


def _saves_pkl(name):
    """Saved planner_data pickle of a map / served site."""
    return os.path.join(_SAVES_DIR, name + ".pkl")

# --- Site-bundle (WP-C) -----------------------------------------------------
# Optional: persist zones/programs to the canonical per-garden site bundle
# (~/.vitulus/mapping_v3/<site>/) in UTM, alongside the legacy pickles. Guarded
# so a missing/unbuilt vitulus_mapping never breaks the planner. navi_man's
# mapdata module is needed to read the active map's UTM datum from its
# maps_data pickle (same sys.path pattern navi_man/other tools use).
# The vitulus_navi package is located through rospkg (with safe fallbacks), so
# the planner does not depend on the name/location of the catkin workspace.
