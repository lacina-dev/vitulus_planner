    def rotate_ring_to_nearest_start(self, ring, ref_point):
        """Return a new LinearRing rotated so coords[0] is the vertex nearest to ref_point."""
        coords = list(ring.coords[:-1])  # exclude the closing duplicate
        nearest_idx = min(
            range(len(coords)),
            key=lambda i: (coords[i][0] - ref_point.x) ** 2 + (coords[i][1] - ref_point.y) ** 2
        )
        rotated = coords[nearest_idx:] + coords[:nearest_idx]
        rotated.append(rotated[0])  # close the ring
        return geometry.LinearRing(rotated)

    def get_polygons_ordered_by_start(self):
        int_polygons = []
        ext_polygons = []
        out_polygons = []
        for polygon in self.filter_polygons():
            ext_polygons.append(polygon.exterior)
            if polygon.interiors:
                for in_poly in polygon.interiors:
                    int_polygons.append(in_poly)

        if not ext_polygons:
            return out_polygons

        # Starting reference: first clicked point of the zone polygon
        if hasattr(self.current_zone, 'start_point') and self.current_zone.start_point is not None:
            ref_point = self.current_zone.start_point
        else:
            ref_point = geometry.Point(ext_polygons[0].coords[0])

        # Exterior outlines — greedy nearest vertex, rotate each ring to start there
        while ext_polygons:
            nearest_dist = float('inf')
            nearest_idx = 0
            for n, pol in enumerate(ext_polygons):
                coords = list(pol.coords[:-1])
                d = min((c[0] - ref_point.x) ** 2 + (c[1] - ref_point.y) ** 2 for c in coords)
                if d < nearest_dist:
                    nearest_dist = d
                    nearest_idx = n
            pol = ext_polygons.pop(nearest_idx)
            rotated = self.rotate_ring_to_nearest_start(pol, ref_point)
            out_polygons.append(rotated)
            # Outline is a closed loop: robot ends back at coords[0]
            ref_point = geometry.Point(rotated.coords[0])

        # Interior holes (obstacles) — chain from end of last exterior
        if out_polygons:
            ref_point = geometry.Point(out_polygons[-1].coords[0])
        while int_polygons:
            nearest_dist = float('inf')
            nearest_idx = 0
            for n, pol in enumerate(int_polygons):
                coords = list(pol.coords[:-1])
                d = min((c[0] - ref_point.x) ** 2 + (c[1] - ref_point.y) ** 2 for c in coords)
                if d < nearest_dist:
                    nearest_dist = d
                    nearest_idx = n
            pol = int_polygons.pop(nearest_idx)
            rotated = self.rotate_ring_to_nearest_start(pol, ref_point)
            out_polygons.append(rotated)
            ref_point = geometry.Point(rotated.coords[0])

        return out_polygons

    def filter_list_of_polygons(self, polygons_in, min_length=0.8, min_area=0.3):
        polygons = []
        for poly in polygons_in:
            if poly.length > min_length and poly.area > min_area:
                polygons.append(poly)
        return polygons

    def create_coverage_paths(self):
        self.log_publisher("Creating coverage paths...")
        # Prepare outline polygons
        top_level_polygons = self.get_top_level_outline_poly()
        top_level_polygons = self.filter_list_of_polygons(top_level_polygons)

        first_level_polygons = self.get_first_level_outline_poly()
        first_level_polygons = self.filter_list_of_polygons(first_level_polygons)

        multilines = []
        raw_lines_by_pass = {}  # {pass_idx: [LineString, ...]} — raw coverage lines, no connectors
        angle = self.current_zone.msg.coverage_angle
        paths_distance = self.current_zone.msg.paths_distance
        for polygon in top_level_polygons:
            max_length = 50.5 + shapely.distance(geometry.Point(polygon.bounds[0], polygon.bounds[1]),
                                                geometry.Point(polygon.bounds[2], polygon.bounds[3]))
            paths_offset = int(round((0.6 / paths_distance)))
            for i_line_offset in range(0, paths_offset):
                paths_distance_offset = paths_distance * paths_offset
                # Create lines for coverage
                offset = i_line_offset * paths_distance
                start = geometry.Point(polygon.bounds[0], polygon.bounds[1], 0.0)
                end = geometry.Point(start.x + max_length, start.y, 0.0)
                # end = geometry.Point(start.x + max_length, start.y + offset, 0.0)
                line_list = []
                line_count = int(max_length / paths_distance_offset)
                for n in range(0, line_count):
                    line = geometry.LineString([start, end])
                    line_list.append(line)
                    start = geometry.Point(start.x, start.y + paths_distance_offset, 0.0)
                    end = geometry.Point(end.x, end.y + paths_distance_offset, 0.0)
                multiline = geometry.MultiLineString(line_list)

                # center with border polygon
                move_x = polygon.centroid.x - multiline.centroid.x
                move_y = polygon.centroid.y - multiline.centroid.y
                multiline = affinity.translate(multiline, xoff=move_x, yoff=move_y, zoff=0)
                # print("multiline centroid: {}".format(multiline.centroid))

                # rotate lines
                multiline = affinity.rotate(multiline, angle, origin="center", use_radians=False)

                # offset curve of multilines
                offset_multiline = []
                for line in multiline.geoms:
                    line_new = geometry.LineString(line.coords)
                    line_new = line_new.offset_curve(offset, quad_segs=16, join_style=1, mitre_limit=5.0)
                    offset_multiline.append(line_new)
                multiline = geometry.MultiLineString(offset_multiline)

                # cut lines to fit the polygon outer border
                multiline = shapely.ops.split(multiline, polygon.buffer(-0.1))

                # remove lines out of the zone
                line_list = []
                for line in multiline.geoms:
                    if shapely.contains_properly(polygon, line):
                        line_list.append(line)
                multiline = geometry.MultiLineString(line_list)

                # Remove short lines
                line_list = []
                for line in multiline.geoms:
                    if line.length > 0.15:
                        line_list.append(line)
                multiline = geometry.MultiLineString(line_list)

                # Store raw coverage lines per pass (before connector generation)
                raw_lines_by_pass.setdefault(i_line_offset, []).extend(list(multiline.geoms))

                # connect lines by nearest point of other lines
                line_list = []
                for line in multiline.geoms:
                    line_list.append([[line.coords[0][0], line.coords[0][1]],
                                      [line.coords[1][0], line.coords[1][1]]])
                np_lines = np.array(line_list)
                line_list = []
                x = polygon.bounds[0] - 1000
                y = polygon.bounds[3] + 1000
                point = geometry.Point(x, y)
                i_all = 0
                direction = True  # True: forward, False: backward
                dir_last = None  # True: forward, False: backward
                while True:
                    nearest_line = None
                    distance = 9999999
                    ni = 0
                    i_line = 0
                    # Find the nearest line from point
                    for line in np_lines:
                        begin_point = geometry.Point([line[0][0], line[0][1]])
                        end_point = geometry.Point([line[1][0], line[1][1]])
                        if begin_point.distance(point) < distance:
                            distance = begin_point.distance(point)
                            nearest_line = line
                            direction = True
                            i_line = ni
                        if end_point.distance(point) < distance:
                            distance = end_point.distance(point)
                            nearest_line = [line[1], line[0]]  # reverse line
                            direction = False
                            i_line = ni
                        ni = ni + 1
                    if nearest_line is not None:  # if any nearest line available
                        conn_line = geometry.LineString(
                            [[point.x, point.y], [nearest_line[0][0], nearest_line[0][1]]])
                        is_cross = self.is_crossing_polygons(conn_line, first_level_polygons)
                        if not is_cross:  # if the line is not crossing polygon check other lines
                            is_cross = self.is_crossing_other_lines(conn_line, [], geometry.MultiLineString(line_list))
                        if not is_cross:  # if the line is not crossing, connect
                            line_list.append(conn_line)
                            line_list.append(geometry.LineString(nearest_line))
                        else:  # if the line is crossing, close cell
                            if len(line_list) != 0:
                                # print("Error: line_list is empty.")
                                multilines.append(geometry.MultiLineString(line_list))
                            line_list = []
                            line_list.append(geometry.LineString(nearest_line))

                        point = geometry.Point([nearest_line[1][0], nearest_line[1][1]])
                        np_lines = np.delete(np_lines, [i_line], 0)
                        dir_last = direction
                        i_all = i_all + 1

                    else:
                        break
                multilines.append(geometry.MultiLineString(line_list))
        self.current_zone.multilines = multilines
        n_passes = max(raw_lines_by_pass.keys()) + 1 if raw_lines_by_pass else 0
        self.current_zone.multilines_by_pass = [raw_lines_by_pass.get(i, []) for i in range(n_passes)]

        # Draw multilines to map
        for multiline in multilines:
            self.current_zone.np_zone_paths = self.draw_multilines(multiline, self.current_zone.np_zone_paths)

    def build_coverage_pass_paths(self, raw_lines, ref_point, first_level_polygons):
        """Greedy ordering of raw coverage lines starting from ref_point.

        Each line can be traversed forward or reversed — whichever endpoint is
        nearer. Connections that would cross a polygon boundary get a large
        distance penalty so the greedy picks a less-obstructed line first.
        When a connection inevitably crosses an obstacle the current path
        segment is closed and a new one begins (the navigator handles the
        transit between segments via full path planning).

        Returns (list_of_MultiLineString, end_point).
        """
        if not raw_lines:
            return [], ref_point

        PENALTY = 1000.0
        remaining = list(range(len(raw_lines)))
        result_segments = []
        current_segment = []
        current_point = ref_point

        while remaining:
            best_idx = None
            best_dist = float('inf')
            best_reversed = False

            for idx in remaining:
                line = raw_lines[idx]
                p_start = geometry.Point(line.coords[0])
                p_end = geometry.Point(line.coords[-1])

                # Cost to reach start of line (forward direction)
                d_fwd = current_point.distance(p_start)
                if d_fwd > 0.001:
                    conn_fwd = geometry.LineString([[current_point.x, current_point.y],
                                                   [p_start.x, p_start.y]])
                    if self.is_crossing_polygons(conn_fwd, first_level_polygons):
                        d_fwd *= PENALTY

                # Cost to reach end of line (reversed direction)
                d_rev = current_point.distance(p_end)
                if d_rev > 0.001:
                    conn_rev = geometry.LineString([[current_point.x, current_point.y],
                                                   [p_end.x, p_end.y]])
                    if self.is_crossing_polygons(conn_rev, first_level_polygons):
                        d_rev *= PENALTY

                if d_fwd <= d_rev:
                    d, rev = d_fwd, False
                else:
                    d, rev = d_rev, True

                if d < best_dist:
                    best_dist = d
                    best_idx = idx
                    best_reversed = rev

            remaining.remove(best_idx)
            chosen_line = raw_lines[best_idx]
            if best_reversed:
                chosen_line = geometry.LineString(list(reversed(chosen_line.coords)))

            chosen_start = geometry.Point(chosen_line.coords[0])
            dist_to_start = current_point.distance(chosen_start)

            # Decide whether to connect directly or start a new segment
            needs_connector = dist_to_start > 0.001 and len(current_segment) > 0
            can_connect = False
            conn = None
            if needs_connector:
                conn = geometry.LineString([[current_point.x, current_point.y],
                                           [chosen_start.x, chosen_start.y]])
                can_connect = not self.is_crossing_polygons(conn, first_level_polygons)

            if needs_connector and not can_connect:
                # Obstacle in the way — close current segment, start fresh
                result_segments.append(geometry.MultiLineString(current_segment))
                current_segment = []

            if needs_connector and can_connect:
                current_segment.append(conn)

            current_segment.append(chosen_line)
            current_point = geometry.Point(chosen_line.coords[-1])

        if current_segment:
            result_segments.append(geometry.MultiLineString(current_segment))

        return result_segments, current_point

    def create_coverage_path_msg(self):
        # Determine starting reference: end of outline path
        outline = self.current_zone.path_msg_outline
        if outline.poses:
            last = outline.poses[-1].pose.position
            ref_point = geometry.Point(last.x, last.y)
        elif hasattr(self.current_zone, 'start_point') and self.current_zone.start_point is not None:
            ref_point = self.current_zone.start_point
        else:
            top_poly = self.get_top_level_outline_poly()
            top_poly = self.filter_list_of_polygons(top_poly)
            ref_point = geometry.Point(top_poly[0].centroid) if top_poly else geometry.Point(0, 0)

        first_level_polygons = self.get_first_level_outline_poly()
        first_level_polygons = self.filter_list_of_polygons(first_level_polygons)

        path_all = Path()
        path_all.header.frame_id = "map"
        path_all.header.stamp = rospy.Time.now()

        # Process each pass in order; passes are already stored as raw coverage lines
        for pass_raw_lines in (self.current_zone.multilines_by_pass or []):
            if not pass_raw_lines:
                continue
            pass_segments, ref_point = self.build_coverage_pass_paths(
                pass_raw_lines, ref_point, first_level_polygons)

            for multiline in pass_segments:
                path = Path()
                path.header.frame_id = "map"
                path.header.stamp = rospy.Time.now()
                for line in multiline.geoms:
                    angle = self.direction(line.coords)
                    self.current_zone.msg.length += line.length
                    for point in line.coords:
                        pose = PoseStamped()
                        pose.header.frame_id = "map"
                        pose.header.stamp = rospy.Time.now()
                        pose.pose.position.x = point[0]
                        pose.pose.position.y = point[1]
                        pose.pose.position.z = 0.0
                        pose.pose.orientation = Quaternion(
                            *(kdl.Rotation.RPY(0, 0, angle).GetQuaternion()))
                        path.poses.append(pose)
                        path_all.poses.append(pose)
                self.current_zone.msg.paths.append(path)

        self.current_zone.path_msg_coverage = path_all

    def create_outline_path_msg(self):
        # Create path from coverage lines
        path_all = Path()
        path_all.header.frame_id = "map"
        path_all.header.stamp = rospy.Time.now()
        for polygon in self.get_polygons_ordered_by_start():
            polygon = polygon.simplify(self.current_zone.msg.simplify)
            n = 0
            path2 = Path()
            path2.header.frame_id = "map"
            path2.header.stamp = rospy.Time.now()
            for n in range(0, len(polygon.coords) - 1):
                line = geometry.LineString([[polygon.coords[n][0], polygon.coords[n][1]], [polygon.coords[n + 1][0], polygon.coords[n + 1][1]]])
                self.current_zone.msg.length += line.length
                angle = self.direction(line.coords)
                # line = line.segmentize(0.3)
                for point in line.coords:
                    pose = PoseStamped()
                    pose.header.frame_id = "map"
                    pose.header.stamp = rospy.Time.now()
                    pose.pose.position.x = point[0]
                    pose.pose.position.y = point[1]
                    pose.pose.position.z = 0.0
                    pose.pose.orientation = Quaternion(
                        *(kdl.Rotation.RPY(0, 0, angle).GetQuaternion()))
                    path2.poses.append(pose)
                    path_all.poses.append(pose)
            self.current_zone.msg.paths.append(path2)
        self.current_zone.path_msg_outline = path_all

    def direction(self, line):
        # point_2.x - point_1.x, point_2.y - point_1.y)
        x = line[1][0] - line[0][0]
        y = line[1][1] - line[0][1]
        diagonal = math.sqrt(x ** 2 + y ** 2)
        if y < 0:
            if x >= 0:
                angle = math.asin(y / diagonal)
            else:
                angle = math.acos(x / diagonal) * -1
        else:
            if x >= 0:
                angle = math.asin(y / diagonal)
            else:
                angle = math.acos(x / diagonal)
        return angle

